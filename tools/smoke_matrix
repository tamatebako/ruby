#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: tools/smoke_matrix <release-tag>
# Prints the release-src compile-smoke matrix as a GitHub Actions matrix
# document: one leg per (changed line x scenario), where a "changed line"
# is a patches/<line>/ folder touched between the previous release tag and
# <release-tag> (or HEAD when the tag does not exist yet, e.g. a manual
# dispatch ahead of tagging; all lines when there is no previous tag).
#
# Per-version legs (version x scenario of every changed patch set) would
# multiply configure runs for no extra signal: a patch is line-wide, so a
# REPRESENTATIVE leg per line -- the newest version of the changed line,
# per scenario it ships -- covers the changed translation units (documented
# in .github/workflows/release-src.yml). Each leg compiles every patched
# translation unit of that version for the scenario (tools/compile_smoke);
# msys legs run at pass 2 only (the pass split selects GNUmakefile
# variants -- no patched .c differs between passes).
#
# Emits {"include":[]} when no patch set changed: the gate is vacuously
# green (an empty include matrix runs no legs and succeeds).

$LOAD_PATH.unshift(File.expand_path("lib", __dir__))
require "tfs"
require "json"
require "open3"

tag = ARGV[0] or abort "usage: tools/smoke_matrix <release-tag>"

def git(*args)
  out, err, status = Open3.capture3("git", *args)
  abort "tools/smoke_matrix: git #{args.join(' ')} failed: #{err.strip}" unless status.success?

  out
end

tags = git("tag", "--list", "v*", "--sort=-version:refname").lines.map(&:strip).reject(&:empty?)
range =
  if tags.include?(tag)
    older = tags[(tags.index(tag) + 1)..]
    older.empty? ? nil : "#{older.first}..#{tag}"
  elsif tags.empty?
    nil
  else
    "#{tags.first}..HEAD"
  end

lines =
  if range.nil?
    nil # no previous tag: smoke every line
  else
    git("diff", "--name-only", range).lines.map(&:strip)
                                       .filter_map { |path| path[%r{\Apatches/(\d+\.\d+)/}, 1] }
                                       .uniq
  end

versions = Tfs::Versions.new
legs =
  versions.flat_map do |entry|
    next [] unless lines.nil? || lines.include?(entry.line)

    entry.scenarios.map { |scenario| { line: entry.line, version: entry.name, platform: scenario } }
  end
newest = legs.group_by { |leg| [leg[:line], leg[:platform]] }
             .map { |(_line, _platform), group| group.max_by { |leg| Gem::Version.new(leg[:version]) } }

puts JSON.generate({ include: newest })
