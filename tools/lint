#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: tools/lint <version>
# git apply --check of every patch selected for <version> against the
# pristine upstream tree. Fails named (version + patch) on the first patch
# that does not apply.

$LOAD_PATH.unshift(File.expand_path("lib", __dir__))
require "tfs"
require "fileutils"
require "tmpdir"

version = ARGV[0] or abort "usage: tools/lint <version>"
cache_dir = ENV.fetch("TFS_CACHE_DIR", Tfs::SourcePrep::DEFAULT_CACHE_DIR)

prep = Tfs::SourcePrep.new(versions: Tfs::Versions.new,
                           selection: Tfs::PatchSelection.new,
                           cache_dir: cache_dir)
Dir.mktmpdir("tfs-lint-") do |outdir|
  checked = prep.check(version, outdir)
  puts "OK #{version} (#{checked.size} patches apply cleanly)"
end
