#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: tools/apply <version> [outdir] [--platform NAME] [--pass 1|2]
# Builds <outdir>/tfs-ruby-<version>-src: pristine upstream tree with the
# version's canonical patch set applied for one coherent build scenario.
# Tarballs are fetched from the official URLs (versions.yml),
# sha256-verified, and cached under .cache/tarballs (override with
# TFS_CACHE_DIR).

$LOAD_PATH.unshift(File.expand_path("lib", __dir__))
require "tfs"
require "fileutils"
require "optparse"

def native_platform
  case RUBY_PLATFORM
  when /linux-musl/ then "linux-musl"
  when /linux/ then "linux-gnu"
  when /darwin/ then "darwin"
  when /msys|mingw|cygwin/ then "msys"
  else abort "tools/apply: cannot detect platform #{RUBY_PLATFORM}; pass --platform"
  end
end

options = { platform: nil, pass: 2 }
OptionParser.new do |parser|
  parser.banner = "usage: tools/apply <version> [outdir] [--platform NAME] [--pass 1|2]"
  parser.on("--platform NAME", "linux-gnu | linux-musl | darwin | msys (default: host)") { |v| options[:platform] = v }
  parser.on("--pass N", Integer, "GNUmakefile.in pass variant, 1 or 2 (default: 2, final build)") { |v| options[:pass] = v }
end.parse!

version = ARGV[0] or abort "usage: tools/apply <version> [outdir] [--platform NAME] [--pass 1|2]"
outdir = File.expand_path(ARGV[1] || "build")
platform = options[:platform] || native_platform
cache_dir = ENV.fetch("TFS_CACHE_DIR", Tfs::SourcePrep::DEFAULT_CACHE_DIR)

FileUtils.mkdir_p(outdir)
prep = Tfs::SourcePrep.new(versions: Tfs::Versions.new,
                           selection: Tfs::PatchSelection.new,
                           cache_dir: cache_dir)
puts prep.prepare(version, outdir, platform: platform, pass: options[:pass])
