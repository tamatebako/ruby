#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: tools/validate_msys_pairs
# Semantic pair check: every version's msys GNUmakefile rubyw.exe recipe
# that carries $(MUNICODE_FLAG) must be paired with the
# winmain_c_wwinmain_msys patch (and vice versa). Exits non-zero on any
# violation.

$LOAD_PATH.unshift(File.expand_path("lib", __dir__))
require "tfs"

errors = Tfs::WinmainPairLint.new.errors
errors.each { |error| warn error }
abort "FAIL #{errors.size} msys pair violation(s)" unless errors.empty?

puts "OK all msys manifests pair -municode with winmain"
