#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: tools/build_matrix <release-tag> [--build|--copies|--previous-tag]
#
# Prints release-src's diff-aware build plan (Tfs::BuildPlan over
# Tfs::ReleaseDiff, the same previous-tag diff base tools/smoke_matrix
# uses) as GitHub Actions matrix documents:
#
#   --build   {"include":[{version,platform,pass,suffix,tree,asset},...]} —
#             the legs to COMPILE: versions of changed patch lines, plus
#             every version on a shared tooling change (tools/**, ci/**,
#             schema/** or any unattributable path), plus versions whose
#             versions.yml entry is new or moved, plus everything on the
#             first release.
#   --copies  {"include":[{version,suffix,asset},...]} — the legs CARRIED
#             FORWARD from the previous release, sha256-verified against
#             its published SHA256SUMS (tools/copy_asset).
#   --previous-tag — the bare tag the copies come from (empty on the first
#             release).
#
# With no flag, prints all three as one JSON document. `--line X.Y`
# narrows the build/copy plans to one line's rows (the per-line release
# workflows each plan their own); `--lines` prints the line list itself.

$LOAD_PATH.unshift(File.expand_path("lib", __dir__))
require "tfs"
require "json"
require "tempfile"

tag = ARGV[0] or abort "usage: tools/build_matrix <release-tag> [--build|--copies|--previous-tag|--lines] [--line X.Y]"
mode = ARGV[1] || "--all"
unless %w[--build --copies --previous-tag --lines --all].include?(mode)
  abort "tools/build_matrix: unknown mode #{mode.inspect} (want --build, --copies, --previous-tag or --lines)"
end
line = ARGV[2] == "--line" ? ARGV[3] : nil

diff = Tfs::ReleaseDiff.new(tag)
versions = Tfs::Versions.new
previous_versions = nil
unless diff.previous_tag.nil?
  begin
    Tempfile.create(["versions", ".yml"]) do |file|
      file.write(diff.previous_file("versions.yml"))
      file.flush
      previous_versions = Tfs::Versions.new(file.path)
    end
  rescue Tfs::ReleaseDiff::Error, ArgumentError => e
    abort "tools/build_matrix: cannot read versions.yml at #{diff.previous_tag}: #{e.message}"
  end
end

plan = Tfs::BuildPlan.new(versions: versions, diff: diff, previous_versions: previous_versions)
document = {
  "build" => { "include" => plan.builds(line: line) },
  "copies" => { "include" => plan.copies(line: line) },
  "previous_tag" => diff.previous_tag
}

case mode
when "--build" then puts JSON.generate(document["build"])
when "--copies" then puts JSON.generate(document["copies"])
when "--previous-tag" then puts diff.previous_tag
when "--lines" then puts JSON.generate(versions.map(&:line).uniq.sort)
else puts JSON.generate(document)
end
