# win32_clock_rename_msys.patch
#
# Target:  win32/win32.c (pass1 + pass2 (msys))
# Source:  tebako gem lib/tebako/packager/pass1_patch.rb Pass1MSysPatch::WIN32_WIN32_C_CLOCK_PATCH, pass2msys_patch.rb WIN32_WIN32_C_MSYS_PATCHES
#
# msys: ruby's win32.c defines clock_gettime/clock_getres fallbacks with
# no HAVE_* configure guard; modern mingw-w64 winpthreads headers
# (pthread_time.h, pulled in by time.h) carry static-inline definitions of
# the same symbols, so the build fails with redefinition errors. Rename
# ruby's fallbacks; the CRT/winpthreads implementations (which configure
# detects) serve the calls. Applied in pass1 (toolchain build) and
# re-applied in pass2 (final build, from pristine sources).
diff --git a/win32/win32.c b/win32/win32.c
index 82b02d1..78dcba6 100644
--- a/win32/win32.c
+++ b/win32/win32.c
@@ -4695,7 +4695,7 @@
 
 /* License: Ruby's */
 int
-clock_gettime(clockid_t clock_id, struct timespec *sp)
+_dummy_clock_gettime(clockid_t clock_id, struct timespec *sp)
 {
     switch (clock_id) {
       case CLOCK_REALTIME:
@@ -4735,7 +4735,7 @@
 
 /* License: Ruby's */
 int
-clock_getres(clockid_t clock_id, struct timespec *sp)
+_dummy_clock_getres(clockid_t clock_id, struct timespec *sp)
 {
     switch (clock_id) {
       case CLOCK_REALTIME:
