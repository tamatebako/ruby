# dln_c_tebako_includes.patch
#
# Target:  dln.c (pass2 (linux gnu/musl, macos))
# Source:  tebako gem lib/tebako/packager/pass2_patch.rb Pass2Patch#dln_c_patch
#
# Route dlopen of memfs-resident extensions through the libtfs c_api: a
# memfs file is first mapped to a host file, then dlopen'ed; host paths load
# as-is (non-msys; dlxxx function substitution is not used on Windows).
# libtfs c_api extension (requested): tebako_fs_dlmap2file -- extract a
# memfs file to a host path, the modern counterpart of the legacy
# tebako_dlmap2file.
# X-Redesign: modern-api
diff --git a/dln.c b/dln.c
index 44e8c06..98f4694 100644
--- a/dln.c
+++ b/dln.c
@@ -83,7 +83,31 @@ char *getenv();
 # endif
 #endif
 
+/* -- Start of tebako patch -- */
+#include <tebako/tebako-main.h> /* tebako_mount_point(): the compiled-in fs_mount_point */
+
+/* Route check: is path inside the memfs mount? (mount-point prefix check vs
+   the compiled-in fs_mount_point; the memfs is read-only -- writes/cwd go to
+   the host fs unchanged) */
+static int
+tfs_memfs_path_p(const char *path)
+{
+    const char *mount = tebako_mount_point();
+    size_t mount_len;
+    if (path == NULL || mount == NULL) return 0;
+    mount_len = strlen(mount);
+    return strncmp(path, mount, mount_len) == 0;
+}
+
+/* libtfs c_api extension (requested): tebako_fs_dlmap2file -- extract a
+   memfs file to a host path (the modern counterpart of the legacy
+   tebako_dlmap2file); declared here so this translation unit stays
+   C99-clean meanwhile */
+char *tebako_fs_dlmap2file(const char *path);
+/* -- End of tebako patch -- */
+
 #ifndef dln_loaderror
+
 static void
 dln_loaderror(const char *format, ...)
 {
@@ -370,7 +394,23 @@ dln_open(const char *file)
 #endif
 
 	/* Load file */
-	if ((handle = (void*)dlopen(file, RTLD_LAZY|RTLD_GLOBAL)) == NULL) {
+	/* -- Start of tebako patch -- */
+	if (tfs_memfs_path_p(file)) {
+	    /* memfs-resident extension: map to a host file via the libtfs c_api
+	       (extension requested: tebako_fs_dlmap2file) and dlopen that */
+	    char *mapped = tebako_fs_dlmap2file(file);
+	    if (mapped == NULL) {
+	        error = "cannot map a memfs-resident library to a host file";
+	        goto failed;
+	    }
+	    handle = (void*)dlopen(mapped, RTLD_LAZY|RTLD_GLOBAL);
+	    free(mapped);
+	}
+	else {
+	    handle = (void*)dlopen(file, RTLD_LAZY|RTLD_GLOBAL);
+	}
+	/* -- End of tebako patch -- */
+	if (handle == NULL) {
 	    error = dln_strerror();
 	    goto failed;
 	}
