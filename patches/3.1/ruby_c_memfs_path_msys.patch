# ruby_c_memfs_path_msys.patch
#
# Target:  ruby.c (pass2 (msys))
# Source:  tebako gem lib/tebako/packager/pass2msys_patch.rb RUBY_C_MSYS_PATCHES
#
# msys: keep memfs paths as-is (rb_str_new_cstr) instead of making them
# relative with RUBY_RELATIVE when resolving the load path. The in-mount
# check is a mount-point prefix check vs the compiled-in fs_mount_point
# (tebako_mount_point()); the memfs is read-only -- writes/cwd go to the
# host fs unchanged. fcntl on memfs file descriptors is emulated through
# the tebako_fd_is_embedded dispatch (tfs_fcntl: FD_CLOEXEC stored, status
# flags report O_RDONLY, F_SETFL/F_SETFD are no-ops on the read-only
# memfs), so open_load_file/disable_nonblock works on the packaged entry
# script; host fds pass through to the real fcntl.
# X-Redesign: modern-api
diff --git a/ruby.c b/ruby.c
index 189f631..7734372 100644
--- a/ruby.c
+++ b/ruby.c
@@ -66,6 +66,65 @@
 #include "ruby/version.h"
 #include "ruby/internal/error.h"
 
+/* -- Start of tebako patch -- */
+#include <tebako/tebako-main.h> /* tebako_mount_point(): the compiled-in fs_mount_point */
+#include <tebako/fs/c_api.h>     /* modern libtfs C API (tebako_fs_*) */
+#include <string.h>               /* strlen/strncmp/memset/memcpy used below */
+#include <errno.h>                /* ENOENT for the host-passthrough fall-through */
+
+/* Route check: does the TFS mount table claim this path? (v2 multi-mount:
+   the driver mounts the env image at the runtime root AND each payload at
+   its declared point, so the v1 mount-point prefix check is replaced by the
+   c_api coverage query. A covered path the mounts do not hold answers
+   ENOENT from the c_api -- jail-gated host passthrough -- and the wrappers
+   below pass it through to the host fs.) */
+static int
+tfs_memfs_path_p(const char *path)
+{
+    if (path == NULL) return 0;
+    return tebako_path_is_embedded(path);
+}
+
+/* fcntl on a memfs fd: the memfs is read-only, so the flag state is
+   emulated (FD_CLOEXEC stored, status flags report O_RDONLY); calls on host
+   fds pass through to the real fcntl */
+static int
+tfs_fcntl(int fd, int cmd, ...)
+{
+    static int cloexec_flags;
+    va_list ap;
+    int arg = 0;
+
+    va_start(ap, cmd);
+    arg = va_arg(ap, int);
+    va_end(ap);
+
+    if (!tebako_fd_is_embedded(fd)) {
+        return fcntl(fd, cmd, arg);
+    }
+#ifndef F_GETFL
+#define F_GETFL 3 /* mingw: ruby's win32.h keeps F_GETFL inside #if 0 */
+#endif
+
+    switch (cmd) {
+    case F_GETFD:
+        return cloexec_flags;
+    case F_SETFD:
+        cloexec_flags = arg;
+        return 0;
+    case F_GETFL:
+        return O_RDONLY;
+    case F_SETFL:
+        return 0;
+    default:
+        errno = EINVAL;
+        return -1;
+    }
+}
+
+#define fcntl(...) tfs_fcntl(__VA_ARGS__)
+/* -- End of tebako patch -- */
+
 #ifndef MAXPATHLEN
 # define MAXPATHLEN 1024
 #endif
@@ -755,7 +810,12 @@
     id_initial_load_path_mark = INITIAL_LOAD_PATH_MARK;
     while (*paths) {
 	size_t len = strlen(paths);
-	VALUE path = RUBY_RELATIVE(paths, len);
+	/* -- Start of tebako patch -- */
+        VALUE path = tfs_memfs_path_p(paths) ?
+                        rb_str_new_cstr(paths) :
+                        RUBY_RELATIVE(paths, len);
+        /* -- End of tebako patch -- */
+
 	rb_ivar_set(path, id_initial_load_path_mark, path);
 	rb_ary_push(load_path, path);
 	paths += len + 1;
