# dln_c_dlmap_msys.patch
#
# Target:  dln.c (pass2 (msys))
# Source:  tebako gem lib/tebako/packager/pass2_patch.rb Pass2Patch#dln_c_patch, patch_literals.rb DLN_C_MSYS_PATCH / DLN_C_MSYS_PATCH_PRE32
#
# msys: route dlopen of memfs paths through the libtfs c_api: a memfs file
# is first mapped to a host file (tebako_fs_dlmap2file), then converted with
# rb_w32_mbstr_to_wstr and loaded; host paths convert as-is.
# libtfs c_api extension (requested): tebako_fs_dlmap2file -- extract a
# memfs file to a host path, the modern counterpart of the legacy
# tebako_dlmap2file.
# X-Redesign: modern-api
diff --git a/dln.c b/dln.c
index 44e8c06..6cf83f8 100644
--- a/dln.c
+++ b/dln.c
@@ -83,7 +83,32 @@ char *getenv();
 # endif
 #endif
 
+/* -- Start of tebako patch -- */
+#include <tebako/tebako-main.h> /* tebako_mount_point(): the compiled-in fs_mount_point */
+#include <string.h>               /* strlen/strncmp/memset/memcpy used below */
+
+/* Route check: is path inside the memfs mount? (mount-point prefix check vs
+   the compiled-in fs_mount_point; the memfs is read-only -- writes/cwd go to
+   the host fs unchanged) */
+static int
+tfs_memfs_path_p(const char *path)
+{
+    const char *mount = tebako_mount_point();
+    size_t mount_len;
+    if (path == NULL || mount == NULL) return 0;
+    mount_len = strlen(mount);
+    return strncmp(path, mount, mount_len) == 0;
+}
+
+/* libtfs c_api extension (requested): tebako_fs_dlmap2file -- extract a
+   memfs file to a host path (the modern counterpart of the legacy
+   tebako_fs_dlmap2file); declared here so this translation unit stays
+   C99-clean meanwhile */
+char *tebako_fs_dlmap2file(const char *path);
+/* -- End of tebako patch -- */
+
 #ifndef dln_loaderror
+
 static void
 dln_loaderror(const char *format, ...)
 {
@@ -318,7 +343,24 @@ dln_load(const char *file)
     init_funcname(&buf, file);
 
     /* Convert the file path to wide char */
+/* -- Start of tebako patch -- */
+  char *f = NULL;
+  winfile = NULL;
+  if (file && tfs_memfs_path_p(file)) {
+    f = tebako_fs_dlmap2file(file);
+    if (f) {
+      winfile = rb_w32_mbstr_to_wstr(CP_UTF8, f, -1, NULL);
+      free(f);
+    }
+    else {
+      goto failed;
+    }
+  }
+  else {
     winfile = rb_w32_mbstr_to_wstr(CP_UTF8, file, -1, NULL);
+  }
+/* -- End of tebako patch -- */
+
     if (!winfile) {
 	dln_memerror();
     }
