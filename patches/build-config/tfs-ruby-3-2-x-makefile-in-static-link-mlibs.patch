# tfs-ruby-3-2-x-makefile-in-static-link-mlibs.patch
#
# Target:  template/Makefile.in (pass2 (linux gnu/musl, macos))
# Applies: ruby 3.2.x (3.2.4 - 3.2.7)
# Source:  tebako gem lib/tebako/packager/patch_buildsystem.rb PatchBuildsystem TEMPLATE_MAKEFILE_IN_BASE_*, pass2_patch.rb Pass2Patch#mlibs_subst
#
# Link the ruby program against LIBRUBYARG_STATIC instead of LIBRUBYARG
# (configure's --disable-shared does not do it) and replace the @MAINLIBS@
# value with the tebako static library set. NOTE: @TEBAKO_MLIBS@ is a
# placeholder substituted at packaging time with the
# platform/dependency-specific library list (gem: PatchLibraries.mlibs).
diff --git a/template/Makefile.in b/template/Makefile.in
index e189d88..4ca0383 100644
--- a/template/Makefile.in
+++ b/template/Makefile.in
@@ -131,7 +131,10 @@ XDLDFLAGS = @DLDFLAGS@
 DLDFLAGS = @LIBRUBY_DLDFLAGS@ $(XLDFLAGS) $(ARCH_FLAG)
 SOLIBS = @SOLIBS@
 ENABLE_DEBUG_ENV = @ENABLE_DEBUG_ENV@
-MAINLIBS = $(YJIT_LIBS) @MAINLIBS@
+# -- Start of tebako patch -- 
+MAINLIBS = $(YJIT_LIBS) @TEBAKO_MLIBS@
+# -- End of tebako patch -- 
+
 ARCHMINIOBJS = @MINIOBJS@
 DLNOBJ = @DLNOBJ@
 ENCOBJS = @ENCOBJS@
@@ -306,7 +309,9 @@ miniruby$(EXEEXT):
 $(PROGRAM):
 		@$(RM) $@
 		$(ECHO) linking $@
-		$(Q) $(PURIFY) $(CC) $(EXE_LDFLAGS) $(XLDFLAGS) $(MAINOBJ) $(EXTOBJS) $(LIBRUBYARG) $(MAINLIBS) $(LIBS) $(EXTLIBS) $(OUTFLAG)$@
+# -- Start of tebako patch --
+		$(Q) $(PURIFY) $(CC) $(EXE_LDFLAGS) $(MAINOBJ) $(EXTOBJS) $(LIBRUBYARG_STATIC) $(OUTFLAG)$@
+# -- End of tebako patch --
 		$(Q) $(POSTLINK)
 
 $(PROGRAM): @XRUBY_LIBPATHENV_WRAPPER@
