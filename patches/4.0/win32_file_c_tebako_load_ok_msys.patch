# win32_file_c_tebako_load_ok_msys.patch
#
# Target:  win32/file.c (pass2 (msys))
# Source:  tebako gem lib/tebako/packager/pass2msys_patch.rb WIN32_FILE_C_MSYS_PATCHES
#
# msys: return early from the UTF-8 -> wide-char path conversion when the
# file is loadable from the memfs. The check is stat-based: a mount-point
# prefix check vs the compiled-in fs_mount_point (tebako_mount_point())
# plus tebako_fs_stat (the memfs is read-only; directories are not
# loadable). Non-mount paths pass to the host fs unchanged.
# X-Redesign: modern-api
diff --git a/win32/file.c b/win32/file.c
index 26b9971..74b9a6c 100644
--- a/win32/file.c
+++ b/win32/file.c
@@ -11,6 +11,41 @@
 #include <shlwapi.h>
 #include "win32/file.h"
 
+/* -- Start of tebako patch -- */
+#include <tebako/tebako-main.h> /* tebako_mount_point(): the compiled-in fs_mount_point */
+#include <string.h>               /* strlen/strncmp/memset/memcpy used below */
+#include <errno.h>                /* ENOENT for the host-passthrough fall-through */
+
+/* ruby/win32.h maps 'stat' onto stati128; the libtfs C API fills the CRT
+   struct stat, so keep the plain name visible inside this block */
+#pragma push_macro("stat")
+#undef stat
+#include <tebako/fs/c_api.h>     /* modern libtfs C API (tebako_fs_*) */
+
+/* Route check: does the TFS mount table claim this path? (v2 multi-mount:
+   the driver mounts the env image at the runtime root AND each payload at
+   its declared point, so the v1 mount-point prefix check is replaced by the
+   c_api coverage query. A covered path the mounts do not hold answers
+   ENOENT from the c_api -- jail-gated host passthrough -- and the wrappers
+   below pass it through to the host fs.) */
+static int
+tfs_memfs_path_p(const char *path)
+{
+    if (path == NULL) return 0;
+    return tebako_path_is_embedded(path);
+}
+
+/* stat-based "in mount?" check: the file is loadable from the read-only
+   memfs when it stats and is not a directory */
+static int
+tfs_file_loadable_p(const char *path)
+{
+    struct stat st;
+    return tfs_memfs_path_p(path) && tebako_fs_stat(path, &st) == 0 && !S_ISDIR(st.st_mode);
+}
+#pragma pop_macro("stat")
+/* -- End of tebako patch -- */
+
 #ifndef INVALID_FILE_ATTRIBUTES
 # define INVALID_FILE_ATTRIBUTES ((DWORD)-1)
 #endif
@@ -589,7 +624,11 @@ rb_file_load_ok(const char *path)
     long len;
     wchar_t* wpath;
 
-    wpath = mbstr_to_wstr(CP_UTF8, path, -1, &len);
+    /* -- Start of tebako patch -- */
+  if (tfs_file_loadable_p(path)) return ret;
+    /* -- End of tebako patch -- */
+wpath = mbstr_to_wstr(CP_UTF8, path, -1, &len);
+
     if (!wpath) return 0;
 
     attr = GetFileAttributesW(wpath);
