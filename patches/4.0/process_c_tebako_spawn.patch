# process_c_tebako_spawn.patch
#
# Target:  process.c (pass2 (all platforms))
# Source:  v2 design (TODO.testing/08 — exec of memfs-resident binaries)
#
# Spawn of a memfs-resident binary: the kernel never sees the memfs, so
# an exec target HELD by the mounts (tebako_path_is_embedded) is
# materialized to the host cache (tebako_fs_exec_materialize — home-layout mounts whole-tree) and the exec
# pair (command_name, command_abspath — the child execve()s
# command_abspath) is pointed at the host copy. The child re-enters the
# namespace through the preload shim (DYLD_INSERT_LIBRARIES/LD_PRELOAD
# at the in-VFS path read from TEBAKO_PRELOAD_SHIM — the driver's flow
# of the env image's layout grant, with a literal fallback for images
# predating the grant) plus the current mounts (TEBAKO_TFS_MOUNTS),
# injected via env_modification in ruby's internal representation
# (hidden array of hidden [key, val] pairs — a hash here crashes
# parent_start1).
# Host targets pass through untouched; a covered path the mounts do not
# hold answers ENOENT and exec fails honestly. Bare command names (PATH
# search) do not resolve through the VFS. Shell-form spawns bridge their
# in-VFS argument tokens parent-side to materialized host twins (spec 22
# §3.1's shell-form rule — the windows §3.2 argv bridge's POSIX twin;
# ruby-jing's `java -jar <in-image jar>` is the standing case): the
# shell's own exec target stays the host's.
# The hook is parent-side (before fork), so the materialization work
# (malloc/extract) never runs in the async-signal-safe child.
# darwin24 (macos arm64, factory run 31699651270): dyld TERMINATES an
# Apple-restricted binary at exec when the inherited
# DYLD_INSERT_LIBRARIES names a foreign dylib — darwin23 stripped the
# variable instead. Under the driver's process-wide export that killed
# /bin/sh and /usr/bin/cc for every system()/backtick of a packaged
# interpreter. The hook drops the inherited variable per spawn whose
# target is restricted (any shell form; anything resolving into Apple's
# system binary dirs) — a restricted target can never honor the
# insertion on any host, so the scrub loses nothing. Non-restricted
# host targets (a third-party JRE) keep the driver's delivery — spec 22
# §3.1's array form.
# A #! script's exec target is its INTERPRETER, not the script: execve
# of `#!/bin/sh` loads /bin/sh — a fat Apple-restricted binary on the
# runners — which dies under the armed env exactly as if it had been
# named directly (tebako#448; the deploy tree's o/p/ruby is such a
# script). The hook parses the shebang line (first whitespace-delimited
# token after "#!", leading blanks skipped, CRLF tolerated) and applies
# the restricted check to the interpreter — pre-exec on the spawn
# target's own path and again on the materialized host copy, which the
# pre-materialize check could not read. An unreadable file or a
# malformed shebang falls back to the own-path verdict (ruby#96 —
# defense-in-depth parity with the v0.2.4 driver-side scrub, tebako#451).
# win32 (no preload inheritance): the hook additionally BRIDGES embedded
# argv tokens — shell-form cmdline and the argv_buf/argv_str vector are
# rewritten token-by-token through tfs_bridge_arg, and an embedded exec
# target materializes host-side (spec 22 §3.2). The 4.0 series builds
# argv_str with rb_imemo_tmpbuf_new_from_an_RString (the 3.x
# auto_free_pointer variant was folded into it; ruby#104).
# spec 30 §2 (tebako v2.1.0): the POSIX hook's head offers every
# array-form spawn to the driver's spawned-runtime planner
# (tebako_spawn_runtime_plan — a WEAK extern: runtimes linked against
# pre-2.1.0 link units carry no such symbol and pass every spawn through
# exactly as before). A planned bare name (the app payload's
# requires[].expose surface) retargets the exec pair to the store's
# runtime exe, rebuilds argv_buf/argv_str from the plan (the plan's
# argv[0] is the exe; ruby re-prepends it at exec), and applies the
# plan's env ops (KEY=VALUE sets, bare KEY deletes) into
# env_modification. A named error raises — the spawn NEVER falls through
# to a host binary of the same name. The head runs BEFORE the darwin
# restricted-target scrub: a planned spawn's target is the store's exe,
# and the scrub must not pre-empt a plan for a bare name that shadows a
# system stub (/usr/bin/java). POSIX shell-form spawns never plan
# (the wrap-bin launcher tier serves the exposed command, spec 30 §3)
# and their darwin scrub path is unchanged; on windows the shell form
# IS the surface (no launcher tier) — an exposed command token plans
# inline and the string is spliced with the planned boot.
# X-Redesign: v2-spawn
diff --git a/process.c b/process.c
index 97fa336..f55697e 100644
--- a/process.c
+++ b/process.c
@@ -2834,6 +2834,822 @@ rb_execarg_get(VALUE execarg_obj)
     return eargp;
 }
 
+
+/* -- Start of tebako patch -- */
+#include <tebako/fs/c_api.h>     /* modern libtfs C API (tebako_fs_*) */
+#include <stdlib.h>              /* free */
+#include <ctype.h>               /* isspace */
+#include <stdio.h>               /* fopen/fread */
+#include <sys/stat.h>            /* stat, S_ISREG */
+
+/* Push KEY=VAL into eargp->env_modification using ruby's internal
+   representation: a hidden array of hidden [key, val] pairs (see
+   check_exec_env_i).  rb_execarg_parent_start1 applies pairs in order
+   via st_insert, so a later pair for the same key wins — the mounts
+   list and the preload path are authoritative for the child. */
+static void
+tfs_env_set(struct rb_execarg *eargp, const char *key, const char *val)
+{
+    VALUE env = eargp->env_modification;
+    if (!RB_TYPE_P(env, T_ARRAY)) {
+        env = hide_obj(rb_ary_new());
+        eargp->env_modification = env;
+    }
+    rb_ary_push(env, hide_obj(rb_assoc_new(EXPORT_STR(rb_str_new_cstr(key)),
+                                           EXPORT_STR(rb_str_new_cstr(val)))));
+}
+
+/* Delete KEY from the child's environment: the nil pair DELETES the
+   inherited entry (rb_execarg_parent_start1's NIL_P branch, st_delete).
+   The spawn plan's bare-KEY env ops (spec 30 §2) and the darwin
+   restricted-target scrub (spec 22 §3.1) share the primitive. */
+static void
+tfs_env_unset(struct rb_execarg *eargp, const char *key)
+{
+    VALUE env = eargp->env_modification;
+    if (!RB_TYPE_P(env, T_ARRAY)) {
+        env = hide_obj(rb_ary_new());
+        eargp->env_modification = env;
+    }
+    rb_ary_push(env, hide_obj(rb_assoc_new(EXPORT_STR(rb_str_new_cstr(key)),
+                                           Qnil)));
+}
+
+/* spec 30 §2's spawned-runtime planner, exported by the driver
+   (tebako-driver ffi.rs; exports.txt owns the surface). WEAK where
+   the platform allows: a runtime linked against a pre-2.1.0 link
+   unit carries no such symbol — the reference then reads NULL and
+   every spawn passes through exactly as before; a strong reference
+   would break those lines at link time. Windows links STRONG (PE
+   has no weak externs): the factory's link-unit pin (>= v2.1.0)
+   always carries the symbol, so a mismatch fails the build loudly,
+   never degrades silently at run time. */
+extern int tebako_spawn_runtime_plan(const char *command,
+                                     const char *args_packed, size_t args_len,
+                                     char **out_exe,
+                                     char **out_argv, size_t *out_argv_len,
+                                     char **out_env, size_t *out_env_len,
+                                     char **out_error)
+#if defined(__APPLE__)
+    __attribute__((weak_import));
+#elif defined(_WIN32)
+    ;
+#else
+    __attribute__((weak));
+#endif
+
+/* The plan's env ops in application order: "KEY=VALUE" sets, a bare
+   "KEY" deletes (spec 30 §2's wire). tfs_env_set/unset copy into ruby
+   strings, so the scratch key is freed here. */
+static void
+tfs_spawn_env_ops(struct rb_execarg *eargp, const char *ops, size_t len)
+{
+    const char *p = ops;
+    const char *ep = ops + len;
+    while (p < ep) {
+        size_t tlen = strlen(p);
+        const char *eq = memchr(p, '=', tlen);
+        if (eq == NULL) {
+            char *k = (char *)malloc(tlen + 1);
+            if (k != NULL) {
+                memcpy(k, p, tlen);
+                k[tlen] = '\0';
+                tfs_env_unset(eargp, k);
+                free(k);
+            }
+        }
+        else {
+            size_t klen = (size_t)(eq - p);
+            char *k = (char *)malloc(klen + 1);
+            if (k != NULL) {
+                memcpy(k, p, klen);
+                k[klen] = '\0';
+                tfs_env_set(eargp, k, eq + 1);
+                free(k);
+            }
+        }
+        p += tlen + 1;
+    }
+}
+
+/* A planned spawn (spec 30 §2): the plan's exe becomes the exec pair;
+   argv_buf takes the plan's tokens AFTER argv[0] (ruby re-prepends the
+   program at exec from command_abspath — and the plan's argv[0] IS that
+   exe); argv_str's pointer vector is rebuilt into the new buffer exactly
+   as rb_exec_fillarg built it (the vector points INTO the buffer's
+   storage, so a new buffer means a rebuilt vector). */
+static void
+tfs_spawn_plan_apply(struct rb_execarg *eargp, const char *exe,
+                     const char *argv, size_t argv_len,
+                     const char *env, size_t env_len)
+{
+    const char *p = argv;
+    const char *ep = argv + argv_len;
+    const char *null = NULL;
+    VALUE nbuf;
+    VALUE av;
+    eargp->invoke.cmd.command_name = rb_str_new_cstr(exe);
+    eargp->invoke.cmd.command_abspath = rb_str_new_cstr(exe);
+    if (p < ep) p += strlen(p) + 1;  /* the plan's argv[0] is the exe */
+    nbuf = hide_obj(rb_str_buf_new((ep - p) + 1));
+    while (p < ep) {
+        rb_str_buf_cat(nbuf, p, strlen(p) + 1);
+        p += strlen(p) + 1;
+    }
+    eargp->invoke.cmd.argv_buf = nbuf;
+    av = hide_obj(rb_str_buf_new(0));
+    rb_str_buf_cat(av, (char *)&null, sizeof(null)); /* try_with_sh placeholder */
+    {
+        const char *q = RSTRING_PTR(nbuf);
+        const char *eq = q + RSTRING_LEN(nbuf);
+        while (q < eq) {
+            rb_str_buf_cat(av, (char *)&q, sizeof(q));
+            q += strlen(q) + 1;
+        }
+    }
+    rb_str_buf_cat(av, (char *)&null, sizeof(null));
+    eargp->invoke.cmd.argv_str =
+        rb_imemo_tmpbuf_new_from_an_RString(av);
+    if (env != NULL && env_len > 0) tfs_spawn_env_ops(eargp, env, env_len);
+}
+
+/* The plan head, shared by both platform hooks: offer the spawn to
+   the driver's planner. Returns 1 when a plan was applied (the exec
+   pair, argv, and env ops all replaced), 0 on pass-through (not an
+   exposed name — or a pre-2.1.0 link unit, where the weak
+   reference reads NULL). A named error raises — the spawn NEVER
+   falls through to a host binary of the same name. `args` may be
+   NULL with args_len 0 (the windows shell form plans with no known
+   arguments — the PATH launcher tier's own behavior, spec 30 §3). */
+static int
+tfs_spawn_plan_head(struct rb_execarg *eargp, const char *prog,
+                    const char *args, size_t args_len)
+{
+    char *exe = NULL;
+    char *argv = NULL;
+    char *env = NULL;
+    char *err = NULL;
+    size_t argv_len = 0;
+    size_t env_len = 0;
+    int rc;
+#ifndef _WIN32
+    if (tebako_spawn_runtime_plan == NULL) return 0;
+#endif
+    rc = tebako_spawn_runtime_plan(prog, args, args_len,
+                                   &exe, &argv, &argv_len,
+                                   &env, &env_len, &err);
+    if (rc < 0) {
+        VALUE msg = rb_str_new_cstr(err != NULL ? err
+                                    : "spawn plan failed without a message");
+        free(err);
+        rb_exc_raise(rb_exc_new_str(rb_eRuntimeError, msg));
+    }
+    if (rc != 1) return 0;
+    tfs_spawn_plan_apply(eargp, exe, argv, argv_len, env, env_len);
+    free(exe);
+    free(argv);
+    free(env);
+    return 1;
+}
+
+#ifndef _WIN32
+#if defined(__APPLE__)
+/* execvp's PATH search mirrored parent-side (empty elements mean "."):
+   the first executable candidate wins; no hit returns prog unchanged —
+   the child's own search then fails the same way. */
+static const char *
+tfs_resolve_in_path(const char *prog, char *buf, size_t buflen)
+{
+    const char *path = getenv("PATH");
+    const char *p, *e;
+    size_t len;
+
+    if (path == NULL) return prog;
+    for (p = path;; p = e + 1) {
+        e = strchr(p, ':');
+        len = e != NULL ? (size_t)(e - p) : strlen(p);
+        if (len == 0) {
+            if (access(prog, X_OK) == 0) return prog;
+        }
+        else if (len + strlen(prog) + 2 <= buflen) {
+            memcpy(buf, p, len);
+            buf[len] = '/';
+            strcpy(buf + len + 1, prog);
+            if (access(buf, X_OK) == 0) return buf;
+        }
+        if (e == NULL) break;
+    }
+    return prog;
+}
+
+/* Anything resolving into Apple's system binary dirs is a restricted
+   target — the platform binaries dyld refuses a foreign insertion for. */
+static int
+tfs_path_restricted(const char *path)
+{
+    static const char *const restricted_dirs[] = {
+        "/bin/", "/sbin/", "/usr/bin/", "/usr/sbin/", "/usr/libexec/", "/System/"
+    };
+    size_t i;
+
+    for (i = 0; i < sizeof(restricted_dirs) / sizeof(restricted_dirs[0]); i++) {
+        if (strncmp(path, restricted_dirs[i], strlen(restricted_dirs[i])) == 0)
+            return 1;
+    }
+    return 0;
+}
+
+/* A #! script's exec target is its INTERPRETER: execve of a `#!/bin/sh`
+   file loads /bin/sh — a fat Apple-restricted binary on the runners —
+   which dies under the armed env exactly as if it had been named
+   directly (tebako#448; the deploy tree's o/p/ruby is such a script).
+   Parse the shebang line into buf: the interpreter is the first
+   whitespace-delimited token after "#!", leading blanks skipped, CRLF
+   tolerated. Returns 1 with the token in buf; an unreadable file or a
+   malformed shebang returns 0, and the caller keeps the own-path
+   verdict. The regular-file stat comes first: fopen of a fifo would
+   block waiting for a writer. */
+static int
+tfs_shebang_interpreter(const char *prog, char *buf, size_t buflen)
+{
+    struct stat st;
+    FILE *fp;
+    char line[256];
+    size_t n, i, j;
+
+    if (stat(prog, &st) != 0 || !S_ISREG(st.st_mode)) return 0;
+    fp = fopen(prog, "rb");
+    if (fp == NULL) return 0;
+    n = fread(line, 1, sizeof(line) - 1, fp);
+    fclose(fp);
+    if (n < 2 || line[0] != '#' || line[1] != '!') return 0;
+
+    i = 2;
+    while (i < n && line[i] != '\n' && isspace((unsigned char)line[i])) i++;
+    j = 0;
+    while (i < n && line[i] != '\n' && !isspace((unsigned char)line[i])) {
+        if (j + 1 >= buflen) return 0;  /* token overruns the buffer: malformed */
+        buf[j++] = line[i++];
+    }
+    if (j == 0) return 0;               /* no interpreter token: malformed */
+    buf[j] = '\0';
+    return 1;
+}
+
+/* The spawn target dyld would kill under the armed env: any shell form
+   (the shell is always a platform binary), anything resolving into
+   Apple's system binary dirs, and a #! script whose INTERPRETER is
+   restricted — execve loads the interpreter, not the script. A bare
+   name resolves through the PATH mirror above — /usr/bin/cc is
+   restricted even when named "cc". An unreadable file or a malformed
+   shebang falls back to the own-path verdict. */
+static int
+tfs_spawn_target_restricted(struct rb_execarg *eargp)
+{
+    char resolved[MAXPATHLEN];
+    char interp[MAXPATHLEN];
+    const char *prog;
+
+    if (eargp->use_shell) return 1;
+    prog = RB_TYPE_P(eargp->invoke.cmd.command_abspath, T_STRING)
+         ? RSTRING_PTR(eargp->invoke.cmd.command_abspath) : NULL;
+    if (prog == NULL && RB_TYPE_P(eargp->invoke.cmd.command_name, T_STRING))
+        prog = RSTRING_PTR(eargp->invoke.cmd.command_name);
+    if (prog == NULL) return 0;
+    if (strchr(prog, '/') == NULL)
+        prog = tfs_resolve_in_path(prog, resolved, sizeof(resolved));
+    if (tfs_path_restricted(prog)) return 1;
+    return tfs_shebang_interpreter(prog, interp, sizeof(interp))
+        && tfs_path_restricted(interp);
+}
+#endif
+
+/* Shell-form argument bridging (spec 22 §3.1): a shell-string spawn
+   (backticks, `system "cmd …"`) never plans, and the shell's own
+   exec target stays the host's — but the string can carry ARGUMENT
+   tokens naming in-VFS paths the shell's children cannot read
+   (ruby-jing's `java -jar <in-image jar> … 2>&1`: the wrap-bin
+   launcher serves `java` itself, then the child JVM cannot open the
+   jar — the packed-mn OIML leg died on exactly that). Bridge
+   parent-side: tokenize on unquoted blanks honoring single and
+   double quotes (backslash escapes are not parsed — the known
+   callers emit none), probe each token with one wrapping quote
+   layer stripped, and rewrite an embedded hit to its materialized
+   host twin — tebako_fs_exec_materialize, the exec-target hook's
+   own primitive (home-layout mounts extract whole-tree, other
+   mounts answer the file). Separators copy byte-for-byte, so an
+   all-host string stays byte-identical; a bridged token re-quotes
+   single (a materialized path may carry blanks or a '$'; single
+   quotes protect every byte but a quote, which rides the '\''
+   idiom). A covered path the mounts do not hold keeps its
+   spelling — the child answers honestly (the exec-target hook's
+   own pass-through discipline). */
+
+/* Probe one token: a malloc'd host twin when the token names a
+   mounted path, NULL otherwise. One wrapping quote layer (single
+   or double) is stripped for the probe. */
+static char *
+tfs_bridge_arg(const char *tok, size_t len)
+{
+    char *probe;
+    char *mapped;
+    if (len >= 2 && ((tok[0] == '"' && tok[len - 1] == '"') ||
+                     (tok[0] == '\'' && tok[len - 1] == '\''))) {
+        tok++;
+        len -= 2;
+    }
+    if (len == 0) return NULL;
+    probe = (char *)malloc(len + 1);
+    if (probe == NULL) return NULL;
+    memcpy(probe, tok, len);
+    probe[len] = '\0';
+    if (!tebako_path_is_embedded(probe)) {
+        free(probe);
+        return NULL;
+    }
+    mapped = tebako_fs_exec_materialize(probe);
+    free(probe);
+    return mapped;  /* NULL: covered but not held — pass through */
+}
+
+/* Append a host twin single-quoted for /bin/sh: '…' with an
+   interior quote riding the '\'' idiom. */
+static void
+tfs_bridge_cat_quoted(VALUE out, const char *twin)
+{
+    const char *p;
+    rb_str_buf_cat(out, "'", 1);
+    for (p = twin; *p != '\0'; p++) {
+        if (*p == '\'')
+            rb_str_buf_cat(out, "'\\''", 4);
+        else
+            rb_str_buf_cat(out, p, 1);
+    }
+    rb_str_buf_cat(out, "'", 1);
+}
+
+/* Shell form: rewrite the command string when any token bridges.
+   Token boundaries are unquoted blanks; the separators are copied
+   as they are, so an all-host command line stays byte-identical. */
+static void
+tfs_bridge_cmdline(VALUE *strp)
+{
+    const char *s;
+    long slen, i = 0;
+    int dirty = 0;
+    VALUE out;
+    if (!RB_TYPE_P(*strp, T_STRING)) return;
+    s = RSTRING_PTR(*strp);
+    slen = RSTRING_LEN(*strp);
+    out = rb_str_buf_new(slen + 32);
+    while (i < slen) {
+        long start, tlen;
+        char *twin;
+        while (i < slen && (s[i] == ' ' || s[i] == '\t')) {
+            rb_str_buf_cat(out, s + i, 1);
+            i++;
+        }
+        if (i >= slen) break;
+        start = i;
+        {
+            char q = '\0';
+            while (i < slen) {
+                char c = s[i];
+                if (q == '\0') {
+                    if (c == ' ' || c == '\t') break;
+                    if (c == '\'' || c == '"') q = c;
+                }
+                else if (c == q) {
+                    q = '\0';
+                }
+                i++;
+            }
+        }
+        tlen = i - start;
+        twin = tfs_bridge_arg(s + start, (size_t)tlen);
+        if (twin != NULL) {
+            tfs_bridge_cat_quoted(out, twin);
+            free(twin);
+            dirty = 1;
+        }
+        else {
+            rb_str_buf_cat(out, s + start, (size_t)tlen);
+        }
+    }
+    if (dirty) *strp = out;
+    RB_GC_GUARD(out);
+}
+
+/* Spawn of a memfs-resident binary: materialize the exec target to the
+   host cache, point command_abspath at it (the child execve()s
+   command_abspath; command_name follows for error reporting), and put
+   the preload shim + the current mounts into the child's environment so
+   its own IO resolves through the VFS.  Shell-form spawns bridge their
+   in-VFS argument TOKENS parent-side (above) — the shell itself stays
+   the host's — and bare command names (PATH search) do not resolve
+   through the VFS, but a bare name the app payload EXPOSES as a
+   spawned runtime (spec 30 §2) plans into a full child boot FIRST,
+   below. */
+static void
+tfs_spawn_prepare(struct rb_execarg *eargp)
+{
+    const char *prog;
+    const char *shim;
+    char *mapped;
+    char *preload;
+    char *mounts;
+
+    /* Shell form (all POSIX): bridge the argument tokens, keep the
+       host's shell. The darwin scrub is unchanged (tebako#448's
+       /bin/sh rule — the shell is always a restricted target). */
+    if (eargp->use_shell) {
+        tfs_bridge_cmdline(&eargp->invoke.sh.shell_script);
+#if defined(__APPLE__)
+        if (tfs_spawn_target_restricted(eargp)) {
+            tfs_env_unset(eargp, "DYLD_INSERT_LIBRARIES");
+        }
+#endif
+        return;
+    }
+
+    if (!RB_TYPE_P(eargp->invoke.cmd.command_name, T_STRING)) return;
+    prog = RSTRING_PTR(eargp->invoke.cmd.command_name);
+    if (prog == NULL) return;
+
+    /* The plan head runs BEFORE the platform scrub and the VFS flow:
+       a planned bare name retargets to the store's runtime exe, and a
+       named error must never fall through to a host binary of the same
+       name (spec 30 §2). */
+    {
+        VALUE buf = eargp->invoke.cmd.argv_buf;
+        const char *args = NULL;
+        size_t args_len = 0;
+        if (RB_TYPE_P(buf, T_STRING)) {
+            args = RSTRING_PTR(buf);
+            args_len = (size_t)RSTRING_LEN(buf);
+        }
+        if (tfs_spawn_plan_head(eargp, prog, args, args_len)) return;
+    }
+
+#if defined(__APPLE__)
+    /* The scrub: a restricted target dies under the inherited variable
+       at exec, before the VFS flow below could matter. */
+    if (tfs_spawn_target_restricted(eargp)) {
+        tfs_env_unset(eargp, "DYLD_INSERT_LIBRARIES");
+        return;
+    }
+#endif
+
+    if (!tebako_path_is_embedded(prog)) return;
+    mapped = tebako_fs_exec_materialize(prog);
+    if (mapped == NULL) return;  /* covered but not held: a host path — exec answers honestly */
+    eargp->invoke.cmd.command_name = rb_str_new_cstr(mapped);
+    eargp->invoke.cmd.command_abspath = rb_str_new_cstr(mapped);
+    free(mapped);
+
+#if defined(__APPLE__)
+    /* The pre-materialize check saw only the in-VFS path; the host copy
+       may itself be a #! script whose interpreter is restricted — a
+       child dyld cannot save. Re-check before arming the shim
+       (tebako#448: o/p/ruby is a /bin/sh script). */
+    if (tfs_spawn_target_restricted(eargp)) {
+        tfs_env_unset(eargp, "DYLD_INSERT_LIBRARIES");
+        return;
+    }
+#endif
+
+    /* The shim's in-VFS path flows from the env image's layout grant
+       (TEBAKO_PRELOAD_SHIM, exported by the driver — the SSOT); the
+       literal is the transition fallback for an image predating the
+       grant. Its absence only means an older runtime image — the exec
+       proceeds without VFS, answering honestly for paths the host
+       lacks. */
+    shim = getenv("TEBAKO_PRELOAD_SHIM");
+#if defined(__APPLE__)
+    if (shim == NULL || *shim == '\0') shim = "/__tfs__/lib/tebako/libtfs_preload.dylib";
+    preload = tebako_fs_dlmap2file(shim);
+    if (preload != NULL) {
+        tfs_env_set(eargp, "DYLD_INSERT_LIBRARIES", preload);
+        free(preload);
+    }
+#else
+    if (shim == NULL || *shim == '\0') shim = "/__tfs__/lib/tebako/libtfs_preload.so";
+    preload = tebako_fs_dlmap2file(shim);
+    if (preload != NULL) {
+        tfs_env_set(eargp, "LD_PRELOAD", preload);
+        free(preload);
+    }
+#endif
+    mounts = tebako_fs_mounts();
+    if (mounts != NULL) {
+        tfs_env_set(eargp, "TEBAKO_TFS_MOUNTS", mounts);
+        free(mounts);
+    }
+}
+#else  /* _WIN32 */
+/* Windows argv bridging (spec 22 §3.2): no child-side preload exists on
+   windows — the driver's host tier materializes a dependency's declared
+   exes and leads PATH with their dirs, so a bare-name spawn RESOLVES,
+   but the child then runs plain-host and cannot see VFS paths handed to
+   it as ARGUMENTS (ruby-jing / mn2pdf: `java -jar <env-image jar>` — the
+   jar string resolves through ruby's VFS and the host java.exe cannot
+   read it; the packed-mn windows acceptance died on exactly that).
+   Bridge parent-side in this hook: any argument token naming an embedded
+   path is materialized through tebako_fs_exec_materialize (the
+   exec-target hook's own primitive — home-layout mounts extract
+   whole-tree, other mounts answer the file from the dlmap cache) and
+   rewritten to the host twin. Shell-form spawns (both known callers
+   join into one string) are tokenized on unquoted blanks honoring
+   double-quoted regions and rejoined with the separators preserved
+   byte-for-byte; a bridged token is always re-quoted (a materialized
+   path may carry spaces). Array form rebuilds invoke.cmd.argv_buf
+   (NUL-separated) and the argv_str pointer vector exactly as
+   rb_exec_fillarg built them. Non-embedded tokens pass through
+   byte-identical; a covered path the mounts do not hold keeps its
+   spelling — the child answers honestly (the exec-target hook's own
+   pass-through discipline). A bare name the app payload EXPOSES as a
+   spawned runtime plans FIRST (spec 30 §2's head — windows has no
+   launcher tier, spec 30 §3): array form applies the plan to the
+   exec pair and argv; shell form splices the planned boot into the
+   string inline. */
+
+/* Probe one token: a malloc'd host twin when the token names a mounted
+   path, NULL otherwise. One wrapping layer of double quotes is stripped
+   for the probe (an unquoted token holds no blanks by construction; a
+   quoted one may — either way the whole token is the path candidate). */
+static char *
+tfs_bridge_arg(const char *tok, size_t len)
+{
+    char *probe;
+    char *mapped;
+    if (len >= 2 && tok[0] == '"' && tok[len - 1] == '"') {
+        tok++;
+        len -= 2;
+    }
+    if (len == 0) return NULL;
+    probe = (char *)malloc(len + 1);
+    if (probe == NULL) return NULL;
+    memcpy(probe, tok, len);
+    probe[len] = '\0';
+    if (!tebako_path_is_embedded(probe)) {
+        free(probe);
+        return NULL;
+    }
+    mapped = tebako_fs_exec_materialize(probe);
+    free(probe);
+    return mapped;  /* NULL: covered but not held — pass through */
+}
+
+/* Tokenize s[i..slen) on unquoted blanks honoring double-quoted
+   regions, appending each token (bridged when embedded) and the
+   verbatim separators to out; sets *dirtyp when any token bridged.
+   The separators copy as they are, so an all-host range stays
+   byte-identical. */
+static long
+tfs_bridge_span(VALUE out, const char *s, long i, long slen, int *dirtyp)
+{
+    while (i < slen) {
+        long start, tlen;
+        char *twin;
+        while (i < slen && (s[i] == ' ' || s[i] == '\t')) {
+            rb_str_buf_cat(out, s + i, 1);
+            i++;
+        }
+        if (i >= slen) break;
+        start = i;
+        {
+            int inq = 0;
+            while (i < slen) {
+                char c = s[i];
+                if (c == '"')
+                    inq = !inq;
+                else if ((c == ' ' || c == '\t') && !inq)
+                    break;
+                i++;
+            }
+        }
+        tlen = i - start;
+        twin = tfs_bridge_arg(s + start, (size_t)tlen);
+        if (twin != NULL) {
+            rb_str_buf_cat(out, "\"", 1);
+            rb_str_buf_cat(out, twin, strlen(twin));
+            rb_str_buf_cat(out, "\"", 1);
+            free(twin);
+            *dirtyp = 1;
+        }
+        else {
+            rb_str_buf_cat(out, s + start, (size_t)tlen);
+        }
+    }
+    return i;
+}
+
+/* Shell form: rewrite the command line when any token bridges. */
+static void
+tfs_bridge_cmdline(VALUE *strp)
+{
+    const char *s;
+    long slen;
+    int dirty = 0;
+    VALUE out;
+    if (!RB_TYPE_P(*strp, T_STRING)) return;
+    s = RSTRING_PTR(*strp);
+    slen = RSTRING_LEN(*strp);
+    out = rb_str_buf_new(slen + 32);
+    tfs_bridge_span(out, s, 0, slen, &dirty);
+    if (dirty) *strp = out;
+    RB_GC_GUARD(out);
+}
+
+/* The windows shell form IS the spawn surface (spec 30 §3: no
+   launcher tier): when the command token — the first token, one
+   quote layer stripped — names an EXPOSED command, plan it (no
+   known arguments, the launcher tier's own behavior) and splice the
+   planned boot into the string: the quoted store exe + the plan's
+   argv tokens + the remaining tokens bridged, with the separators
+   and any trailing redirections preserved for cmd. The plan's env
+   ops apply through env_modification. An unexposed command takes
+   the plain bridging path. */
+static void
+tfs_bridge_shell_planned(struct rb_execarg *eargp)
+{
+    VALUE *strp = &eargp->invoke.sh.shell_script;
+    const char *s;
+    long slen, b, i, start, tlen;
+    char *cmd;
+    VALUE out;
+    char *exe = NULL;
+    char *argv = NULL;
+    char *env = NULL;
+    char *err = NULL;
+    size_t argv_len = 0, env_len = 0;
+    int rc, dirty = 0;
+
+    if (!RB_TYPE_P(*strp, T_STRING)) return;
+    s = RSTRING_PTR(*strp);
+    slen = RSTRING_LEN(*strp);
+
+    /* The command token's span: leading blanks, then one quote-aware
+       run. */
+    b = 0;
+    while (b < slen && (s[b] == ' ' || s[b] == '\t')) b++;
+    if (b >= slen) return;
+    i = b;
+    {
+        int inq = 0;
+        while (i < slen) {
+            char c = s[i];
+            if (c == '"')
+                inq = !inq;
+            else if ((c == ' ' || c == '\t') && !inq)
+                break;
+            i++;
+        }
+    }
+    start = b;
+    tlen = i - start;
+    if (tlen >= 2 && s[start] == '"' && s[start + tlen - 1] == '"') {
+        start++;
+        tlen -= 2;
+    }
+    if (tlen == 0) return;
+    cmd = (char *)malloc(tlen + 1);
+    if (cmd == NULL) return;
+    memcpy(cmd, s + start, tlen);
+    cmd[tlen] = '\0';
+    rc = tebako_spawn_runtime_plan(cmd, NULL, 0, &exe, &argv, &argv_len,
+                                   &env, &env_len, &err);
+    free(cmd);
+    if (rc < 0) {
+        VALUE msg = rb_str_new_cstr(err != NULL ? err
+                                    : "spawn plan failed without a message");
+        free(err);
+        rb_exc_raise(rb_exc_new_str(rb_eRuntimeError, msg));
+    }
+    if (rc != 1) {
+        tfs_bridge_cmdline(strp);
+        return;
+    }
+
+    out = rb_str_buf_new(slen + (long)argv_len + 32);
+    rb_str_buf_cat(out, s, b);            /* the leading blanks */
+    /* the store exe, quoted: its path may carry blanks */
+    rb_str_buf_cat(out, "\"", 1);
+    rb_str_buf_cat(out, exe, strlen(exe));
+    rb_str_buf_cat(out, "\"", 1);
+    {
+        const char *p = argv;
+        const char *ep = argv + argv_len;
+        if (p < ep) p += strlen(p) + 1;   /* argv[0] is the exe */
+        while (p < ep) {
+            size_t t = strlen(p);
+            rb_str_buf_cat(out, " ", 1);
+            rb_str_buf_cat(out, p, (long)t);
+            p += t + 1;
+        }
+    }
+    tfs_bridge_span(out, s, i, slen, &dirty);  /* the remaining tokens */
+    if (env != NULL && env_len > 0) tfs_spawn_env_ops(eargp, env, env_len);
+    free(exe);
+    free(argv);
+    free(env);
+    *strp = out;
+    RB_GC_GUARD(out);
+}
+
+/* Array form: bridge the NUL-separated argv_buf tokens, then rebuild
+   the argv_str pointer vector exactly as rb_exec_fillarg built it (the
+   vector points INTO the buffer's storage — a rebuilt buffer means a
+   rebuilt vector). */
+static void
+tfs_bridge_argv(struct rb_execarg *eargp)
+{
+    VALUE buf = eargp->invoke.cmd.argv_buf;
+    const char *p;
+    const char *ep;
+    VALUE nbuf;
+    int dirty = 0;
+    if (!RB_TYPE_P(buf, T_STRING)) return;
+    p = RSTRING_PTR(buf);
+    ep = p + RSTRING_LEN(buf);
+    nbuf = hide_obj(rb_str_buf_new(RSTRING_LEN(buf) + 32));
+    while (p < ep) {
+        size_t tlen = strlen(p);
+        char *twin = tfs_bridge_arg(p, tlen);
+        if (twin != NULL) {
+            rb_str_buf_cat(nbuf, twin, strlen(twin) + 1);
+            free(twin);
+            dirty = 1;
+        }
+        else {
+            rb_str_buf_cat(nbuf, p, tlen + 1);
+        }
+        p += tlen + 1;
+    }
+    if (!dirty) {
+        RB_GC_GUARD(nbuf);
+        return;
+    }
+    eargp->invoke.cmd.argv_buf = nbuf;
+    {
+        const char *q = RSTRING_PTR(nbuf);
+        const char *eq = q + RSTRING_LEN(nbuf);
+        const char *null = NULL;
+        VALUE av = hide_obj(rb_str_buf_new(0));
+        rb_str_buf_cat(av, (char *)&null, sizeof(null)); /* try_with_sh placeholder */
+        while (q < eq) {
+            rb_str_buf_cat(av, (char *)&q, sizeof(q));
+            q += strlen(q) + 1;
+        }
+        rb_str_buf_cat(av, (char *)&null, sizeof(null));
+        eargp->invoke.cmd.argv_str =
+            /* 4.0 folded the 3.x auto_free_pointer variant into the one
+               tmpbuf constructor — same xmalloc+copy+own semantics, and
+               rb_imemo_free xfree's every tmpbuf's ptr (imemo.c); 4.0's
+               own rb_exec_fillarg spells it this way. */
+            rb_imemo_tmpbuf_new_from_an_RString(av);
+    }
+}
+
+static void
+tfs_spawn_prepare(struct rb_execarg *eargp)
+{
+    /* Shell form: the exposed-command plan inline (spec 30 §3 —
+       windows has no launcher tier), the plain token bridge
+       otherwise. */
+    if (eargp->use_shell) {
+        tfs_bridge_shell_planned(eargp);
+        return;
+    }
+    /* Array form: a bare name the app payload EXPOSES as a spawned
+       runtime plans into the full child boot FIRST (spec 30 §2). A
+       pass-through's absolute in-VFS exec TARGET then materializes
+       by the POSIX hook's own rule, and the remaining argument
+       tokens bridge below. */
+    if (RB_TYPE_P(eargp->invoke.cmd.command_name, T_STRING)) {
+        VALUE buf = eargp->invoke.cmd.argv_buf;
+        const char *prog = RSTRING_PTR(eargp->invoke.cmd.command_name);
+        const char *args = NULL;
+        size_t args_len = 0;
+        if (RB_TYPE_P(buf, T_STRING)) {
+            args = RSTRING_PTR(buf);
+            args_len = (size_t)RSTRING_LEN(buf);
+        }
+        if (tfs_spawn_plan_head(eargp, prog, args, args_len)) return;
+        if (tebako_path_is_embedded(prog)) {
+            char *mapped = tebako_fs_exec_materialize(prog);
+            if (mapped != NULL) {
+                eargp->invoke.cmd.command_name = rb_str_new_cstr(mapped);
+                eargp->invoke.cmd.command_abspath = rb_str_new_cstr(mapped);
+                free(mapped);
+            }
+        }
+    }
+    tfs_bridge_argv(eargp);
+}
+#endif
+/* -- End of tebako patch -- */
