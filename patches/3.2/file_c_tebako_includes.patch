# file_c_tebako_includes.patch
#
# Target:  file.c (pass2 (all platforms))
# Source:  tebako gem lib/tebako/packager/pass2_patch.rb Pass2Patch#patch_map_base
#
# Route ruby's file metadata io into the tebako memfs via the modern libtfs
# C API (<tebako/fs/c_api.h>, tebako_fs_*): paths under the compiled-in
# fs_mount_point (tebako_mount_point()) go to the memfs, everything else to
# the host fs (the memfs is read-only -- writes/cwd stay on the host).
# access is stat-as-exists (the memfs holds no mode bits beyond existence);
# lstat is served by stat (no symlink notion in the c_api). On msys the
# routing hooks the rb_w32_* layer and converts the CRT struct stat the
# c_api fills to ruby's stati128.
# ruby 3.x on linux routes File.birthtime through statx(2), so a second
# hunk hooks statx for in-mount paths/embedded fds (the memfs carries no
# birthtime: STATX_BTIME stays out of the mask, so birthtime comes back
# unsupported -- never ENOENT).
# On msys the block also hooks flock: File#flock on a memfs fd
# no-op-succeeds (the read-only memfs is process-local; the legacy msys
# patch returned ENOTSUP there -- regression note in the hunk).
# X-Redesign: modern-api
diff --git a/file.c b/file.c
index 3a8439e..2871043 100644
--- a/file.c
+++ b/file.c
@@ -93,6 +93,190 @@
 # define lstat stat
 #endif
 
+/* -- Start of tebako patch -- */
+#include <tebako/tebako-main.h> /* tebako_mount_point(): the compiled-in fs_mount_point */
+#include <string.h>               /* strlen/strncmp/memset/memcpy used below */
+#include <errno.h>                /* ENOENT for the host-passthrough fall-through */
+
+/* ruby/win32.h maps 'stat' onto stati128 on _WIN32; the libtfs C API fills
+   the pinned tebako_stat (the c_api ABI), so keep the plain name visible
+   inside this block */
+#pragma push_macro("stat")
+#undef stat
+#include <tebako/fs/c_api.h>     /* modern libtfs C API (tebako_fs_*) */
+
+/* Route check: does the TFS mount table claim this path? (v2 multi-mount:
+   the driver mounts the env image at the runtime root AND each payload at
+   its declared point, so the v1 mount-point prefix check is replaced by the
+   c_api coverage query. A covered path the mounts do not hold answers
+   ENOENT from the c_api -- jail-gated host passthrough -- and the wrappers
+   below pass it through to the host fs.) */
+static int
+tfs_memfs_path_p(const char *path)
+{
+    if (path == NULL) return 0;
+    return tebako_path_is_embedded(path);
+}
+
+#ifndef _WIN32
+static int
+tfs_stat(const char *path, struct stat *st)
+{
+    if (tfs_memfs_path_p(path)) {
+        int rc = tebako_fs_stat(path, st);
+        if (rc == 0 || errno != ENOENT) return rc;
+    }
+    return stat(path, st);
+}
+
+/* the memfs holds regular files/directories only (no symlink notion in the
+   c_api): stat serves as lstat */
+static int
+tfs_lstat(const char *path, struct stat *st)
+{
+    if (tfs_memfs_path_p(path)) {
+        int rc = tebako_fs_stat(path, st);
+        if (rc == 0 || errno != ENOENT) return rc;
+    }
+    return lstat(path, st);
+}
+
+/* access-as-exists: the memfs is read-only, so an entry that stats is
+   readable (mode bits beyond existence are a host fs concept here) */
+static int
+tfs_access(const char *path, int mode)
+{
+    if (tfs_memfs_path_p(path)) {
+        struct stat st;
+        int rc = tebako_fs_stat(path, &st);
+        if (rc == 0 || errno != ENOENT) return rc;
+    }
+    return access(path, mode);
+}
+
+static int
+tfs_fstat(int fd, struct stat *st)
+{
+    if (tebako_fd_is_embedded(fd)) {
+        return tebako_fs_fstat(fd, st);
+    }
+    return fstat(fd, st);
+}
+
+static int
+tfs_close(int fd)
+{
+    if (tebako_fd_is_embedded(fd)) {
+        return tebako_fs_close(fd);
+    }
+    return close(fd);
+}
+#else  /* _WIN32 */
+/* tebako_fs_stat fills the pinned tebako_stat (the c_api ABI); convert to ruby's stati128 */
+static void
+tfs_stat_to_stati128(const struct tebako_stat *i, struct stati128 *o)
+{
+    o->st_dev = i->st_dev;
+    o->st_ino = i->st_ino;
+    o->st_inohigh = 0;
+    o->st_mode = i->st_mode;
+    o->st_nlink = i->st_nlink;
+    o->st_uid = i->st_uid;
+    o->st_gid = i->st_gid;
+    o->st_rdev = i->st_rdev;
+    o->st_size = i->st_size;
+    o->st_atime = i->st_atime;
+    o->st_atimensec = 0;
+    o->st_mtime = i->st_mtime;
+    o->st_mtimensec = 0;
+    o->st_ctime = i->st_ctime;
+    o->st_ctimensec = 0;
+}
+
+static int
+tfs_ustati128(const char *path, struct stati128 *st)
+{
+    if (tfs_memfs_path_p(path)) {
+        struct tebako_stat stb;
+        int ret = tebako_fs_stat(path, &stb);
+        if (ret == 0) tfs_stat_to_stati128(&stb, st);
+        if (ret == 0 || errno != ENOENT) return ret;
+    }
+    return rb_w32_ustati128(path, st);
+}
+
+static int
+tfs_ulstati128(const char *path, struct stati128 *st)
+{
+    if (tfs_memfs_path_p(path)) {
+        struct tebako_stat stb;
+        int ret = tebako_fs_stat(path, &stb);
+        if (ret == 0) tfs_stat_to_stati128(&stb, st);
+        if (ret == 0 || errno != ENOENT) return ret;
+    }
+    return rb_w32_ulstati128(path, st);
+}
+
+/* access-as-exists, as above */
+static int
+tfs_uaccess(const char *path, int mode)
+{
+    if (tfs_memfs_path_p(path)) {
+        struct tebako_stat stb;
+        int ret = tebako_fs_stat(path, &stb);
+        if (ret == 0 || errno != ENOENT) return ret;
+    }
+    return rb_w32_uaccess(path, mode);
+}
+
+static int
+tfs_fstati128(int fd, struct stati128 *st)
+{
+    if (tebako_fd_is_embedded(fd)) {
+        struct tebako_stat stb;
+        int ret = tebako_fs_fstat(fd, &stb);
+        if (ret == 0) tfs_stat_to_stati128(&stb, st);
+        return ret;
+    }
+    return rb_w32_fstati128(fd, st);
+}
+
+/* File#flock on a memfs fd: the memfs is read-only and process-local, so
+   lock operations are no-ops that succeed -- the POSIX fcntl-lock shim
+   semantics from the tfs_fcntl work. Regression note: the legacy msys
+   patch returned ENOTSUP from rb_file_flock for memfs fds (tebako gem
+   FILE_C_MSYS_PATCH), surfacing as Errno::ENOTSUP on File#flock against
+   memfs paths; host fds pass through to the CRT flock unchanged. */
+static int
+tfs_flock(int fd, int oper)
+{
+    if (tebako_fd_is_embedded(fd)) return 0;
+    return flock(fd, oper);
+}
+#endif /* _WIN32 */
+#pragma pop_macro("stat")
+
+#ifndef _WIN32
+#define stat(...) tfs_stat(__VA_ARGS__)
+#ifdef lstat
+#undef lstat
+#endif
+#define lstat(...) tfs_lstat(__VA_ARGS__)
+#define access(...) tfs_access(__VA_ARGS__)
+#ifdef HAVE_EACCESS
+#define eaccess(...) tfs_access(__VA_ARGS__)
+#endif
+#define fstat(...) tfs_fstat(__VA_ARGS__)
+#define close(...) tfs_close(__VA_ARGS__)
+#else  /* _WIN32 */
+#define rb_w32_ustati128(...) tfs_ustati128(__VA_ARGS__)
+#define rb_w32_ulstati128(...) tfs_ulstati128(__VA_ARGS__)
+#define rb_w32_uaccess(...) tfs_uaccess(__VA_ARGS__)
+#define rb_w32_fstati128(...) tfs_fstati128(__VA_ARGS__)
+#define flock(...) tfs_flock(__VA_ARGS__)
+#endif /* _WIN32 */
+/* -- End of tebako patch -- */
+
 /* define system APIs */
 #ifdef _WIN32
 # include "win32/file.h"
@@ -1191,7 +1365,55 @@
 }
 #   endif
 # endif
 
+/* -- Start of tebako patch -- */
+/* ruby 3.x on linux routes File.birthtime through statx(2): fill the
+   caller's struct statx from the memfs for in-mount paths (and from
+   tebako_fs_fstat for embedded fds); everything else passes to the host.
+   The memfs carries no birthtime, so STATX_BTIME stays out of the mask
+   (File::Stat#birthtime raises NotImplementedError, like any fs without
+   btime).
+   NOTE: tebako_fd_is_embedded is a TEBAKO_FD_FLAG (0x40000000) bit check,
+   and AT_FDCWD (-100) has that bit set — the fd branch must be gated on
+   dirfd >= 0 or every host statx(AT_FDCWD, ...) would be misrouted into
+   the memfs and fail EBADF (breaks rbinstall at build time). */
+static void
+tfs_stat_to_statx(const struct stat *i, struct statx *o)
+{
+    memset(o, 0, sizeof(*o));
+    o->stx_mask = STATX_BASIC_STATS;
+    o->stx_mode = i->st_mode;
+    o->stx_nlink = i->st_nlink;
+    o->stx_uid = i->st_uid;
+    o->stx_gid = i->st_gid;
+    o->stx_ino = i->st_ino;
+    o->stx_size = i->st_size;
+    o->stx_mtime.tv_sec = i->st_mtime;
+}
+
+static int
+tfs_statx(int dirfd, const char *pathname, int flags, unsigned int mask, struct statx *statxbuf)
+{
+    struct stat st;
+    if ((dirfd == AT_FDCWD || (pathname != NULL && pathname[0] == '/')) &&
+        tfs_memfs_path_p(pathname)) {
+        if (tebako_fs_stat(pathname, &st) == 0) {
+            tfs_stat_to_statx(&st, statxbuf);
+            return 0;
+        }
+        if (errno != ENOENT) return -1;
+        /* covered but not held: pass through to the host statx */
+    }
+    if (dirfd >= 0 && tebako_fd_is_embedded(dirfd)) {
+        if (tebako_fs_fstat(dirfd, &st) != 0) return -1;
+        tfs_stat_to_statx(&st, statxbuf);
+        return 0;
+    }
+    return statx(dirfd, pathname, flags, mask, statxbuf);
+}
+#define statx(...) tfs_statx(__VA_ARGS__)
+/* -- End of tebako patch -- */
+
 typedef struct no_gvl_statx_data {
     struct statx *stx;
     int fd;
