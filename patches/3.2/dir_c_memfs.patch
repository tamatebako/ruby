# dir_c_memfs.patch
#
# Target:  dir.c (pass2 (linux gnu/musl, macos))
# Source:  tebako gem lib/tebako/packager/pass2_patch.rb Pass2Patch#dir_c_patch, patch_literals.rb DIR_C_BASE_PATCH
#
# Route ruby's directory/stat io into the tebako memfs via the modern libtfs
# C API (<tebako/fs/c_api.h>, tebako_fs_*): paths under the compiled-in
# fs_mount_point (tebako_mount_point()) go to the memfs, everything else to
# the host fs (the memfs is read-only -- writes/cwd stay on the host).
# USE_OPENDIR_AT is forced to 0 so glob takes the routed plain opendir/stat/
# lstat paths (the modern c_api has no openat/fstatat/fdopendir
# counterparts), and ruby's incorrect processing of (f)getattrlist returning
# ENOTSUP on the memfs is compensated by skipping the getattrlist /
# case-sensitivity fast paths for memfs paths (need_normalization handles
# ENOTSUP correctly and is intentionally not patched).
# libtfs c_api extensions (requested): tebako_fs_dir_is_embedded,
# tebako_fs_rewinddir, tebako_fs_telldir, tebako_fs_seekdir -- the dir-handle
# counterparts of the fd introspection/positioning used for the dispatch.
# X-Redesign: modern-api
diff --git a/dir.c b/dir.c
index 3f73f83..07bef4a 100644
--- a/dir.c
+++ b/dir.c
@@ -81,6 +81,158 @@
 #define USE_NAME_ON_FS_BY_FNMATCH 2	/* select the matching
                                          * basename by fnmatch */
 
+/* -- Start of tebako patch -- */
+#include <tebako/tebako-main.h> /* tebako_mount_point(): the compiled-in fs_mount_point */
+#include <string.h>               /* strlen/strncmp/memset/memcpy used below */
+#include <errno.h>                /* ENOENT for the host-passthrough fall-through */
+#include <tebako/fs/c_api.h>     /* modern libtfs C API (tebako_fs_*) */
+
+/* Route check: does the TFS mount table claim this path? (v2 multi-mount:
+   the driver mounts the env image at the runtime root AND each payload at
+   its declared point, so the v1 mount-point prefix check is replaced by the
+   c_api coverage query. A covered path the mounts do not hold answers
+   ENOENT from the c_api -- jail-gated host passthrough -- and the wrappers
+   below pass it through to the host fs.) */
+static int
+tfs_memfs_path_p(const char *path)
+{
+    if (path == NULL) return 0;
+    return tebako_path_is_embedded(path);
+}
+
+static int
+tfs_stat(const char *path, struct stat *st)
+{
+    if (tfs_memfs_path_p(path)) {
+        int rc = tebako_fs_stat(path, st);
+        if (rc == 0 || errno != ENOENT) return rc;
+    }
+    return stat(path, st);
+}
+
+/* the memfs holds regular files/directories only (no symlink notion in the
+   c_api): stat serves as lstat */
+static int
+tfs_lstat(const char *path, struct stat *st)
+{
+    if (tfs_memfs_path_p(path)) {
+        int rc = tebako_fs_stat(path, st);
+        if (rc == 0 || errno != ENOENT) return rc;
+    }
+    return lstat(path, st);
+}
+
+/* libtfs c_api extensions (requested): the dir-handle counterparts of the fd
+   introspection/positioning -- they land with the modern-API dir completion;
+   declared here so this translation unit stays C99-clean meanwhile */
+int tebako_fs_dir_is_embedded(tebako_dir_t dir);
+void tebako_fs_rewinddir(tebako_dir_t dir);
+long tebako_fs_telldir(tebako_dir_t dir);
+void tebako_fs_seekdir(tebako_dir_t dir, long loc);
+
+static DIR *
+tfs_opendir(const char *path)
+{
+    tebako_dir_t tdir;
+    if (tfs_memfs_path_p(path)) {
+        tdir = tebako_fs_opendir(path);
+        /* covered but not held (ENOENT): pass through to the host opendir */
+        if (tdir != NULL || errno != ENOENT) return (DIR *) tdir;
+    }
+    return opendir(path);
+}
+
+/* per-thread adaptation buffer: tebako_c_dirent -> struct dirent */
+static __thread struct dirent tfs_dirent;
+
+static struct dirent *
+tfs_readdir(DIR *dirp)
+{
+    struct tebako_c_dirent *entry;
+    size_t namlen;
+    if (!tebako_fs_dir_is_embedded((tebako_dir_t) dirp)) return readdir(dirp);
+    entry = tebako_fs_readdir((tebako_dir_t) dirp);
+    if (entry == NULL) return NULL;
+    memset(&tfs_dirent, 0, sizeof(tfs_dirent));
+    namlen = strlen(entry->d_name);
+    if (namlen >= sizeof(tfs_dirent.d_name)) namlen = sizeof(tfs_dirent.d_name) - 1;
+    memcpy(tfs_dirent.d_name, entry->d_name, namlen);
+    tfs_dirent.d_name[namlen] = '\0';
+#ifdef DT_UNKNOWN
+    tfs_dirent.d_type = entry->d_type;
+#endif
+    return &tfs_dirent;
+}
+
+static int
+tfs_closedir(DIR *dirp)
+{
+    if (tebako_fs_dir_is_embedded((tebako_dir_t) dirp)) {
+        return tebako_fs_closedir((tebako_dir_t) dirp);
+    }
+    return closedir(dirp);
+}
+
+static void
+tfs_rewinddir(DIR *dirp)
+{
+    if (tebako_fs_dir_is_embedded((tebako_dir_t) dirp)) {
+        tebako_fs_rewinddir((tebako_dir_t) dirp);
+        return;
+    }
+    rewinddir(dirp);
+}
+
+static long
+tfs_telldir(DIR *dirp)
+{
+    if (tebako_fs_dir_is_embedded((tebako_dir_t) dirp)) {
+        return tebako_fs_telldir((tebako_dir_t) dirp);
+    }
+    return telldir(dirp);
+}
+
+static void
+tfs_seekdir(DIR *dirp, long loc)
+{
+    if (tebako_fs_dir_is_embedded((tebako_dir_t) dirp)) {
+        tebako_fs_seekdir((tebako_dir_t) dirp, loc);
+        return;
+    }
+    seekdir(dirp, loc);
+}
+
+/* memfs directories have no host fd: dirfd fails ENOTSUP (need_normalization
+   treats the resulting fgetattrlist failure like the legacy ENOTSUP case) */
+static int
+tfs_dirfd(DIR *dirp)
+{
+    if (tebako_fs_dir_is_embedded((tebako_dir_t) dirp)) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    return dirfd(dirp);
+}
+
+/* glob through the plain opendir/stat/lstat paths: the modern c_api has no
+   openat/fstatat/fdopendir counterparts, and the plain paths are routed */
+#undef USE_OPENDIR_AT
+#define USE_OPENDIR_AT 0
+
+#define stat(...) tfs_stat(__VA_ARGS__)
+#define lstat(...) tfs_lstat(__VA_ARGS__)
+#define opendir(...) tfs_opendir(__VA_ARGS__)
+#define readdir(...) tfs_readdir(__VA_ARGS__)
+#define closedir(...) tfs_closedir(__VA_ARGS__)
+#define rewinddir(...) tfs_rewinddir(__VA_ARGS__)
+#define telldir(...) tfs_telldir(__VA_ARGS__)
+#define seekdir(...) tfs_seekdir(__VA_ARGS__)
+#ifdef dirfd
+#undef dirfd
+#endif
+#define dirfd(...) tfs_dirfd(__VA_ARGS__)
+/* -- End of tebako patch -- */
+
 #ifdef HAVE_GETATTRLIST
 # define USE_NAME_ON_FS USE_NAME_ON_FS_REAL_BASENAME
 # define RUP32(size) ((size)+3/4)
@@ -556,7 +698,7 @@
             dp->dir = opendir_without_gvl(path);
         }
 #ifdef HAVE_GETATTRLIST
-        else if (e == EIO) {
+        else if (e == EIO /* tebako patch */ && !tfs_memfs_path_p(path)) {
             u_int32_t attrbuf[1];
             struct attrlist al = {ATTR_BIT_MAP_COUNT, 0};
             if (getattrlist(path, &al, attrbuf, sizeof(attrbuf), FSOPT_NOFOLLOW) == 0) {
@@ -2413,7 +2555,7 @@
         }
 # endif
 # ifdef HAVE_GETATTRLIST
-        if (is_case_sensitive(dirp, path) == 0)
+        if (is_case_sensitive(dirp, path) == 0 /* tebako patch */ && !tfs_memfs_path_p(path))
             flags |= FNM_CASEFOLD;
 # endif
         ruby_glob_entries_t globent;
@@ -2586,7 +2728,7 @@
                     break;
                 }
 #if USE_NAME_ON_FS == USE_NAME_ON_FS_REAL_BASENAME
-                if ((*cur)->type == ALPHA) {
+                if ((*cur)->type == ALPHA /* tebako patch */ && !tfs_memfs_path_p(buf)) {
                     buf = replace_real_basename(buf, pathlen + (dirsep != 0), enc,
                                                 IF_NORMALIZE_UTF8PATH(1)+0,
                                                 flags, &new_pathtype);
@@ -3323,6 +3465,8 @@
     path = RSTRING_PTR(dirname);
 
 #if defined HAVE_GETATTRLIST && defined ATTR_DIR_ENTRYCOUNT
+    /* tebako patch */ if (!tfs_memfs_path_p(path))
+
     {
         u_int32_t attrbuf[SIZEUP32(fsobj_tag_t)];
         struct attrlist al = {ATTR_BIT_MAP_COUNT, 0, ATTR_CMN_OBJTAG,};
