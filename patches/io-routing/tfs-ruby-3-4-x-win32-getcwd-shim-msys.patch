# tfs-ruby-3-4-x-win32-getcwd-shim-msys.patch
#
# Target:  win32/win32.c (pass2 (msys))
# Applies: ruby 3.4.x (3.4.1 - 3.4.2)
# Source:  tebako gem lib/tebako/packager/pass2msys_patch.rb WIN32_WIN32_C_MSYS_PATCHES
#
# msys: inject the tebako io headers and serve the current-directory query
# from the memfs cwd (tebako_getcwd) when the process runs inside the
# memfs. Pairs with the win32-clock-rename-msys patch, which targets the
# same file.
# X-Redesign: modern-api
diff --git a/win32/win32.c b/win32/win32.c
index 897cd2d..d099849 100644
--- a/win32/win32.c
+++ b/win32/win32.c
@@ -65,6 +65,11 @@
 #include "encindex.h"
 #define isdirsep(x) ((x) == '/' || (x) == '\\')
 
+/* -- Start of tebako patch -- */
+#include <tebako/tebako-config.h>
+#include <tebako/tebako-io.h>
+/* -- End of tebako patch -- */
+
 #if defined _MSC_VER && _MSC_VER <= 1200
 # define CharNextExA(cp, p, flags) CharNextExA((WORD)(cp), (p), (flags))
 #endif
@@ -4865,7 +4870,39 @@ w32_getcwd(char *buffer, int size, UINT cp, void *alloc(int, void *), void *arg)
     WCHAR *p;
     int wlen, len;
 
-    len = GetCurrentDirectoryW(0, NULL);
+    /* -- Start of tebako patch -- */
+  if (is_tebako_cwd()) {
+    char* tebako_cwd = tebako_getcwd(NULL,0);
+    if (tebako_cwd == NULL) {
+      errno = ENOMEM;
+      return NULL;
+    }
+    len = strlen(tebako_cwd) + 1;
+
+    if (buffer) {
+      if (size < len) {
+        free(tebako_cwd);
+        errno = ERANGE;
+        return NULL;
+      }
+    }
+    else {
+      buffer = (*alloc)(len, arg);
+      if (!buffer) {
+        free(tebako_cwd);
+        errno = ENOMEM;
+        return NULL;
+      }
+    }
+    translate_char(tebako_cwd, (char)0x5c, '/', CP_UTF8);
+    strcpy(buffer, tebako_cwd);
+    free(tebako_cwd);
+    return buffer;
+  }
+  /* -- End of tebako patch -- */
+
+  len = GetCurrentDirectoryW(0, NULL);
+
     if (!len) {
         errno = map_errno(GetLastError());
         return NULL;
