# tfs-ruby-3-4-x-dln-c-msys-dlmap.patch
#
# Target:  dln.c (pass2 (msys))
# Applies: ruby 3.4.x (3.4.1 - 3.4.2)
# Source:  tebako gem lib/tebako/packager/pass2_patch.rb Pass2Patch#dln_c_patch, patch_literals.rb DLN_C_MSYS_PATCH / DLN_C_MSYS_PATCH_PRE32
#
# msys: inject the tebako io headers and route dlopen of memfs paths
# through tebako_dlmap2file (extracts the memfs-stored library to a real
# file before rb_w32_mbstr_to_wstr).
# X-Redesign: modern-api
diff --git a/dln.c b/dln.c
index cd9792c..c6c1ffa 100644
--- a/dln.c
+++ b/dln.c
@@ -76,7 +76,13 @@ void *xrealloc();
 # include <unistd.h>
 #endif
 
+/* -- Start of tebako patch -- */
+#include <tebako/tebako-config.h>
+#include <tebako/tebako-io.h>
+/* -- End of tebako patch -- */
+
 #ifndef dln_loaderror
+
 static void
 dln_loaderror(const char *format, ...)
 {
@@ -350,7 +356,24 @@ dln_open(const char *file)
     char message[1024];
 
     /* Convert the file path to wide char */
-    WCHAR *winfile = rb_w32_mbstr_to_wstr(CP_UTF8, file, -1, NULL);
+/* -- Start of tebako patch -- */
+  char *f = NULL;
+  WCHAR *winfile = NULL;
+  if (file && within_tebako_memfs(file)) {
+    f = tebako_dlmap2file(file);
+    if (f) {
+      winfile = rb_w32_mbstr_to_wstr(CP_UTF8, f, -1, NULL);
+      free(f);
+    }
+    else {
+      goto failed;
+    }
+  }
+  else {
+    winfile = rb_w32_mbstr_to_wstr(CP_UTF8, file, -1, NULL);
+  }
+/* -- End of tebako patch -- */
+
     if (!winfile) {
         dln_memerror();
     }
