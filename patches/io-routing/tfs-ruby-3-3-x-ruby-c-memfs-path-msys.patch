# tfs-ruby-3-3-x-ruby-c-memfs-path-msys.patch
#
# Target:  ruby.c (pass2 (msys))
# Applies: ruby 3.3.x (3.3.3 - 3.3.7)
# Source:  tebako gem lib/tebako/packager/pass2msys_patch.rb RUBY_C_MSYS_PATCHES
#
# msys: inject the tebako io headers and keep memfs paths as-is
# (rb_str_new_cstr) instead of making them relative with RUBY_RELATIVE
# when resolving the load path.
# X-Redesign: modern-api
diff --git a/ruby.c b/ruby.c
index 611d887..8d26838 100644
--- a/ruby.c
+++ b/ruby.c
@@ -66,6 +66,11 @@
 STATIC_ASSERT(Qnil_1bit_from_Qfalse, singlebit_only_p(Qnil^Qfalse));
 STATIC_ASSERT(Qundef_1bit_from_Qnil, singlebit_only_p(Qundef^Qnil));
 
+/* -- Start of tebako patch -- */
+#include <tebako/tebako-config.h>
+#include <tebako/tebako-io.h>
+/* -- End of tebako patch -- */
+
 #ifndef MAXPATHLEN
 # define MAXPATHLEN 1024
 #endif
@@ -770,7 +775,12 @@ ruby_init_loadpath(void)
     id_initial_load_path_mark = INITIAL_LOAD_PATH_MARK;
     while (*paths) {
         size_t len = strlen(paths);
-        VALUE path = RUBY_RELATIVE(paths, len);
+        /* -- Start of tebako patch -- */
+        VALUE path = within_tebako_memfs(paths) ?
+                        rb_str_new_cstr(paths) :
+                        RUBY_RELATIVE(paths, len);
+        /* -- End of tebako patch -- */
+
         rb_ivar_set(path, id_initial_load_path_mark, path);
         rb_ary_push(load_path, path);
         paths += len + 1;
