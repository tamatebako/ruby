# mkconfig_memfs_prefix_msys.patch
#
# Target:  tool/mkconfig.rb (pass2 (msys))
#
# msys variant: rewrite CONFIG["prefix"] and CONFIG["RUBY_EXEC_PREFIX"] to
# the tebako memfs mount point (A:/t) in the generated rbconfig.rb,
# run-time overridable via ENV["TEBAKO_MOUNT_ROOT"] (spec 17).
#
# Also embed MAINLIBS literally into LIBRUBYARG_STATIC (see the
# non-msys patch for the rationale).
# X-Redesign: modern-api
--- a/tool/mkconfig.rb
+++ b/tool/mkconfig.rb
@@ -137,6 +137,24 @@
       val = '"$(SDKROOT)"'+val if /darwin/ =~ arch
     end
     v = "  CONFIG[\"#{name}\"] #{eq} #{val}\n"
+# -- Start of tebako patch --
+    # mkmf probe Makefiles reference LIBRUBYARG_STATIC but never define
+    # $(MAINLIBS). Fold the closure in so probes link the same libraries
+    # as the ruby program itself.
+    if name == "LIBRUBYARG_STATIC" && vars["MAINLIBS"]
+      v = v.gsub(/\$\(MAINLIBS\)|\$\{MAINLIBS\}/) { vars["MAINLIBS"] }
+    end
+    v_head_comp = "  CONFIG[\"prefix\"] #{eq} "
+    if v_head_comp == v[0...(v_head_comp.length)]
+      v = "#{v[0...(v_head_comp.length)]}CONFIG[\"RUBY_EXEC_PREFIX\"] = ENV[\"TEBAKO_MOUNT_ROOT\"] || 'A:/t'
+"
+    end
+    v_head_comp = "  CONFIG[\"RUBY_EXEC_PREFIX\"] #{eq} "
+    if v_head_comp == v[0...(v_head_comp.length)]
+      v = "#{v[0...(v_head_comp.length)]}ENV[\"TEBAKO_MOUNT_ROOT\"] || 'A:/t'
+"
+    end
+# -- End of tebako patch --
     if fast[name]
       v_fast << v
     else
