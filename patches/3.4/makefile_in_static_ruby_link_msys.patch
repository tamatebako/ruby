# makefile_in_static_ruby_link_msys.patch
#
# Target:  template/Makefile.in (pass1 + pass2 (msys))
# Source:  tebako gem lib/tebako/packager/patch.rb TEMPLATE_MAKEFILE_IN_STATIC_RUBY_LINK_PATCH
#
# msys: the PROGRAM link in the generated Makefile (the one the exts.mk
# submake links ruby.exe with) has the same static-lib ordering problem as
# the common.mk STATIC_RUBY rule. Ruby 3.3+ links MAINLIBS+EXTLIBS,
# 3.1/3.2 link MAINLIBS+LIBS+EXTLIBS; the gem carries both shapes, only
# one matches per version. Applied in pass1 and pass2.
diff --git a/template/Makefile.in b/template/Makefile.in
index 05432cd..5430272 100644
--- a/template/Makefile.in
+++ b/template/Makefile.in
@@ -300,7 +300,7 @@
 $(PROGRAM):
 		@$(RM) $@
 		$(ECHO) linking $@
-		$(Q) $(PURIFY) $(CC) $(EXE_LDFLAGS) $(XLDFLAGS) $(MAINOBJ) $(EXTOBJS) $(LIBRUBYARG) $(MAINLIBS) $(EXTLIBS) $(OUTFLAG)$@
+		$(Q) $(PURIFY) $(CC) $(EXE_LDFLAGS) $(XLDFLAGS) $(MAINOBJ) $(EXTOBJS) $(LIBRUBYARG) -Wl,--start-group $(MAINLIBS) $(EXTLIBS) -Wl,--end-group $(OUTFLAG)$@ # tebako patched
 		$(Q) $(POSTLINK)
 
 $(PROGRAM): @XRUBY_LIBPATHENV_WRAPPER@
