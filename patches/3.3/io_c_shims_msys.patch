# io_c_shims_msys.patch
#
# Target:  io.c (pass2 (msys))
# Source:  tebako gem lib/tebako/packager/pass2msys_patch.rb Pass2MSysPatch#io_c_patch (IO_C_MSYS_BASE_PATCH, IO_C_MSYS_PATCH[_PRE_32])
#
# msys: route ruby's io into the tebako memfs via the modern libtfs C API
# (<tebako/fs/c_api.h>, tebako_fs_*) at the rb_w32_* layer, route open
# through tfs_open (reads of memfs paths under the compiled-in
# fs_mount_point go to the memfs, write opens there fail EROFS -- the
# memfs is read-only -- and everything else goes to the host fs), and
# treat tebako memfs file descriptors as already-readable in rb_io_wait
# (skip the cancelable wait; tebako_fd_is_embedded is the c_api FD
# introspection).
# libtfs c_api extension (requested): tebako_fs_pread -- a positional read
# that does not move the file position (IO#pread on memfs files).
# X-Redesign: modern-api
diff --git a/io.c b/io.c
index 17f8d57..40511e3 100644
--- a/io.c
+++ b/io.c
@@ -164,10 +164,179 @@
 
 #define IO_MAX_BUFFER_GROWTH 8 * 1024 * 1024 // 8MB
 
+/* -- Start of tebako patch -- */
+#include <tebako/tebako-main.h> /* tebako_mount_point(): the compiled-in fs_mount_point */
+#include <string.h>               /* strlen/strncmp/memset/memcpy used below */
+#include <errno.h>                /* ENOENT for the host-passthrough fall-through */
+
+/* ruby/win32.h maps 'stat' onto stati128; the libtfs C API fills the
+   pinned tebako_stat (the c_api ABI), so keep the plain name visible
+   inside this block */
+#pragma push_macro("stat")
+#undef stat
+#include <tebako/fs/c_api.h>     /* modern libtfs C API (tebako_fs_*) */
+
+/* Route check: does the TFS mount table claim this path? (v2 multi-mount:
+   the driver mounts the env image at the runtime root AND each payload at
+   its declared point, so the v1 mount-point prefix check is replaced by the
+   c_api coverage query. A covered path the mounts do not hold answers
+   ENOENT from the c_api -- jail-gated host passthrough -- and the wrappers
+   below pass it through to the host fs.) */
+static int
+tfs_memfs_path_p(const char *path)
+{
+    if (path == NULL) return 0;
+    return tebako_path_is_embedded(path);
+}
+
+static int
+tfs_open(const char *path, int flags, mode_t mode)
+{
+    int fd;
+
+    if (tfs_memfs_path_p(path)) {
+        fd = tebako_fs_open(path, flags);
+        /* Held content answers in kind: a read open serves the fd, a write
+           open fails EROFS (the mounts are read-only -- bundler's
+           ProcessLock degradation rescues exactly that). ENOENT means the
+           mounts cover but do not hold the path -- a host path, and the
+           c_api has already jail-checked it: pass through to the host
+           open. */
+        if (fd >= 0 || errno != ENOENT) return fd;
+    }
+    return rb_w32_uopen(path, flags, mode);
+}
+
+static ssize_t
+tfs_read(int fd, void *buf, size_t nbyte)
+{
+    if (tebako_fd_is_embedded(fd)) {
+        return tebako_fs_read(fd, buf, nbyte);
+    }
+    return rb_w32_read(fd, buf, nbyte);
+}
+
+/* libtfs c_api extension (requested): tebako_fs_pread -- a positional read
+   that does not move the file position; declared here so this translation
+   unit stays C99-clean meanwhile */
+ssize_t tebako_fs_pread(int fd, void *buf, size_t nbyte, off_t offset);
+
+static ssize_t
+tfs_pread(int fd, void *buf, size_t nbyte, rb_off_t offset)
+{
+    if (tebako_fd_is_embedded(fd)) {
+        return tebako_fs_pread(fd, buf, nbyte, (off_t) offset);
+    }
+    return rb_w32_pread(fd, buf, nbyte, offset);
+}
+
+static rb_off_t
+tfs_lseek(int fd, rb_off_t offset, int whence)
+{
+    if (tebako_fd_is_embedded(fd)) {
+        return (rb_off_t) tebako_fs_lseek(fd, (off_t) offset, whence);
+    }
+    return rb_w32_lseek(fd, offset, whence);
+}
+
+static int
+tfs_close(int fd)
+{
+    if (tebako_fd_is_embedded(fd)) {
+        return tebako_fs_close(fd);
+    }
+    return rb_w32_close(fd);
+}
+
+/* tebako_fs_fstat fills the pinned tebako_stat (the c_api ABI); convert to ruby's stati128 */
+static void
+tfs_stat_to_stati128(const struct tebako_stat *i, struct stati128 *o)
+{
+    o->st_dev = i->st_dev;
+    o->st_ino = i->st_ino;
+    o->st_inohigh = 0;
+    o->st_mode = i->st_mode;
+    o->st_nlink = i->st_nlink;
+    o->st_uid = i->st_uid;
+    o->st_gid = i->st_gid;
+    o->st_rdev = i->st_rdev;
+    o->st_size = i->st_size;
+    o->st_atime = i->st_atime;
+    o->st_atimensec = 0;
+    o->st_mtime = i->st_mtime;
+    o->st_mtimensec = 0;
+    o->st_ctime = i->st_ctime;
+    o->st_ctimensec = 0;
+}
+
+static int
+tfs_fstati128(int fd, struct stati128 *st)
+{
+    if (tebako_fd_is_embedded(fd)) {
+        struct tebako_stat stb;
+        int ret = tebako_fs_fstat(fd, &stb);
+        if (ret == 0) tfs_stat_to_stati128(&stb, st);
+        return ret;
+    }
+    return rb_w32_fstati128(fd, st);
+}
+#pragma pop_macro("stat")
+
+
+/* fcntl on a memfs fd: the memfs is read-only, so the flag state is
+   emulated (FD_CLOEXEC stored, status flags report O_RDONLY); calls on host
+   fds pass through to the real fcntl */
+static int
+tfs_fcntl(int fd, int cmd, ...)
+{
+    static int cloexec_flags;
+    va_list ap;
+    int arg = 0;
+
+    va_start(ap, cmd);
+    arg = va_arg(ap, int);
+    va_end(ap);
+
+    if (!tebako_fd_is_embedded(fd)) {
+        return fcntl(fd, cmd, arg);
+    }
+/* mingw: ruby's win32.h keeps F_GETFL inside #if 0. Use a PRIVATE name —
+   defining F_GETFL itself would leak into every `#if defined(F_GETFL)`
+   feature test for the rest of io.c and flip them from the stock fstat
+   path onto the fcntl path, where mingw-w64's fcntl(F_GETFL) answers
+   EINVAL for non-disk handles: IO.pipe -> IO#initialize rb_sys_fail ->
+   Errno::EINVAL, and rubygems' ext builder dies with "extconf failed" +
+   open3's ensure-masked `nil.close` (msys dogfood incident 7). */
+#define TFS_F_GETFL 3
+
+    switch (cmd) {
+    case F_GETFD:
+        return cloexec_flags;
+    case F_SETFD:
+        cloexec_flags = arg;
+        return 0;
+    case TFS_F_GETFL:
+        return O_RDONLY;
+    case F_SETFL:
+        return 0;
+    default:
+        errno = EINVAL;
+        return -1;
+    }
+}
+
+#define rb_w32_read(...) tfs_read(__VA_ARGS__)
+#define rb_w32_pread(...) tfs_pread(__VA_ARGS__)
+#define rb_w32_lseek(...) tfs_lseek(__VA_ARGS__)
+#define rb_w32_close(...) tfs_close(__VA_ARGS__)
+#define rb_w32_fstati128(...) tfs_fstati128(__VA_ARGS__)
+#define fcntl(...) tfs_fcntl(__VA_ARGS__)
+/* -- End of tebako patch -- */
+
 /* define system APIs */
 #ifdef _WIN32
 #undef open
-#define open	rb_w32_uopen
+#define open(p, f, m) tfs_open((p), (f), (m))
 #undef rename
 #define rename(f, t)	rb_w32_urename((f), (t))
 #include "win32/file.h"
@@ -492,7 +657,8 @@
 
 #if defined(_WIN32)
 #define WAIT_FD_IN_WIN32(fptr) \
-    (rb_w32_io_cancelable_p((fptr)->fd) ? Qnil : rb_io_wait(fptr->self, RB_INT2NUM(RUBY_IO_READABLE), RUBY_IO_TIMEOUT_DEFAULT))
+    ((tebako_fd_is_embedded((fptr)->fd) || rb_w32_io_cancelable_p((fptr)->fd)) ? \
+Qnil : rb_io_wait(fptr->self, RB_INT2NUM(RUBY_IO_READABLE), RUBY_IO_TIMEOUT_DEFAULT))
 #else
 #define WAIT_FD_IN_WIN32(fptr)
 #endif
